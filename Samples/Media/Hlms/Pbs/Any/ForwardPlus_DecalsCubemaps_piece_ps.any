//#include "SyntaxHighlightingMisc.h"

@property( hlms_forwardplus )

@property( hlms_enable_decals )
/// Perform decals *after* sampling the diffuse colour.
@piece( forwardPlusDoDecals )
	@insertpiece( forward3dHeader )

	@property( hlms_decals_normals && normal_map )
		midf3 finalDecalTsNormal = midf3_c( 0.0f, 0.0f, 1.0f );
	@end
	@property( hlms_decals_emissive )
		midf3 finalDecalEmissive = midf3_c( 0.0f, 0.0f, 0.0f );
	@end

	ushort numLightsInGrid = bufferFetch1( f3dGrid, int(sampleOffset + @value(hlms_forwardplus_decals_slot_offset)u) );

	@property( hlms_forwardplus_debug )totalNumLightsInGrid += numLightsInGrid;@end

	float3 posDdx = OGRE_ddx( inPs.pos.xyz );
	float3 posDdy = OGRE_ddy( inPs.pos.xyz );

	for( uint i=0u; i<numLightsInGrid; ++i )
	{
		//Get the light index
		uint idx = bufferFetch1( f3dGrid, int(sampleOffset + i + @value(hlms_forwardplus_decals_slot_offset)u + 1u) );

		float4 invWorldView0	= readOnlyFetch( f3dLightList, int(idx) ).xyzw;
		float4 invWorldView1	= readOnlyFetch( f3dLightList, int(idx + 1u) ).xyzw;
		float4 invWorldView2	= readOnlyFetch( f3dLightList, int(idx + 2u) ).xyzw;
		float4 texIndices		= readOnlyFetch( f3dLightList, int(idx + 3u) ).xyzw;

		float3 localPos;
		localPos.x = dot( invWorldView0.xyzw, float4( inPs.pos.xyz, 1.0f ) );
		localPos.y = dot( invWorldView1.xyzw, float4( inPs.pos.xyz, 1.0f ) );
		localPos.z = dot( invWorldView2.xyzw, float4( inPs.pos.xyz, 1.0f ) );

		float2 decalUvDdx;
		decalUvDdx.x = dot( invWorldView0.xyz, posDdx.xyz );
		decalUvDdx.y = dot( invWorldView2.xyz, posDdx.xyz );
		float2 decalUvDdy;
		decalUvDdy.x = dot( invWorldView0.xyz, posDdy.xyz );
		decalUvDdy.y = dot( invWorldView2.xyz, posDdy.xyz );

		float2 decalUV = localPos.xz + 0.5f;

		@property( hlms_decals_diffuse )
			ushort decalDiffuseIdx = floatBitsToUint( texIndices.x ) & 0xFFFFu;
			midf4 decalDiffuse = OGRE_SampleArray2DGradF16( decalsDiffuseTex, decalsSampler, decalUV.xy,
															decalDiffuseIdx, decalUvDdx, decalUvDdy ).xyzw;
		@end
		@property( hlms_decals_normals && normal_map )
			ushort decalNormalsIdx = floatBitsToUint( texIndices.x ) >> 16u;
			midf2 decalNormals = OGRE_SampleArray2DGradF16( decalsNormalsTex, decalsSampler, decalUV.xy,
															decalNormalsIdx, decalUvDdx, decalUvDdy ).xy;
		@end
		@property( hlms_decals_emissive )
			ushort decalEmissiveIdx = floatBitsToUint( texIndices.y ) & 0xFFFFu;
			midf3 decalEmissive = OGRE_SampleArray2DGradF16( decalsEmissiveTex, decalsSampler, decalUV.xy,
															 decalEmissiveIdx, decalUvDdx, decalUvDdy ).xyz;
		@end

		@property( hlms_decals_diffuse && (hlms_decals_normals || hlms_decals_emissive) )
			bool ignoreAlphaDiffuse = (floatBitsToUint( texIndices.y ) & 0xFFFF0000u) != 0u;
		@end

		//Mask the decal entirely if localPos is outside the debox
		float3 absLocalPos = abs( localPos.xyz );
		bool isOutsideDecal = absLocalPos.x > 0.5f || absLocalPos.y > 0.5f || absLocalPos.z > 0.5f;

		//Mask away objects looking away from the decal.
		//We assume invWorldView is orthogonal, thus the transpose = inverse, hance invWorldView1.xyz
		//works as the decal's direction
		//
		//Use a smooth fade to avoid flickering due to floating point precision when the normal
		//and the decal are perpendicular to each other. (tolerance set to 0.0002)
		midf3 decalDir = normalize( midf3_c( invWorldView1.xyz ) );
		//isOutsideDecal = dot( decalDir.xyz, pixelData.geomNormal.xyz ) <= 0.0 ? true : isOutsideDecal;
		midf normalAway = saturate( (dot( decalDir.xyz, pixelData.geomNormal.xyz ) + _h( 0.0002 ) ) / _h( 0.0002 ) );
		normalAway = isOutsideDecal ? _h( 0.0f ) : normalAway;

		midf decalMask = normalAway;

		@property( hlms_decals_diffuse )
			decalMask *= decalDiffuse.w;
			midf decalMetalness = midf_c( texIndices.z );
			midf3 decalF0 = lerp( midf3_c( 0.03f, 0.03f, 0.03f ), decalDiffuse.xyz, decalMetalness );
			decalDiffuse.xyz = decalDiffuse.xyz - decalDiffuse.xyz * decalMetalness;

			pixelData.diffuse.xyz	= lerp( pixelData.diffuse.xyz, decalDiffuse.xyz * _h( 0.318309886f ), decalMask );
			pixelData.roughness		= lerp( pixelData.roughness, midf_c( texIndices.w ), decalMask );

			@property( !metallic_workflow && !fresnel_workflow && !fresnel_scalar )
				pixelData.specular	= lerp( pixelData.specular.xyz, decalF0, decalMask );
				pixelData.F0		= lerp( pixelData.F0, decalMetalness, decalMask );
			@else
				pixelData.specular	= lerp( pixelData.specular.xyz, midf3_c( 1.0f, 1.0f, 1.0f ), decalMask );
				// JAHSHAKA patch 0031 -- `pixelData.F0` IS NOT ALWAYS A FLOAT3.
				// Its type is `float_fresnel`, which is midf3 only when
				// `fresnel_scalar` is set and midf otherwise (the FresnelSwizzle
				// pair, Main/500.Structs_piece_vs_piece_ps.any:283-287). This
				// branch is taken for `metallic_workflow || fresnel_workflow ||
				// fresnel_scalar`, and the middle one of those three -- an
				// authored F0 in the NON-separate form, which is what
				// HlmsPbsDatablock::setFresnel writes unless the material asked
				// for separate Fresnel -- keeps F0 SCALAR. The unconditional
				// `.xyz` here then fails to compile ("'xyz' : vector swizzle
				// selection out of range") and the whole PBS permutation is
				// lost, which renders black. Split by the same property the
				// declaration uses.
				@property( fresnel_scalar )
					pixelData.F0.xyz = lerp( pixelData.F0.xyz, decalF0.xyz, decalMask );
				@else
					pixelData.F0 = lerp( pixelData.F0, decalF0.x, decalMask );
				@end
			@end

			@property( hlms_decals_normals || hlms_decals_emissive )
				//Reset the mask for the rest of the decal types to ignore our alpha
				decalMask = ignoreAlphaDiffuse ? normalAway : decalMask;
			@end
		@end
		@property( hlms_decals_normals && normal_map )
			finalDecalTsNormal.xy += decalNormals.xy * decalMask;
		@end
		@property( hlms_decals_emissive )
			finalDecalEmissive	+= (absLocalPos.x > 0.5f || absLocalPos.y > 0.5f ||
									absLocalPos.z > 0.5f) ? midf3_c( 0.0f, 0.0f, 0.0f ) :
															(decalEmissive.xyz * decalMask);
		@end

	}
@end /// forwardPlusDoDecals
	@property( hlms_decals_normals && normal_map )
		/// Apply decals normal *after* sampling the tangent space normals (and detail normals too).
		/// hlms_decals_normals will be unset if the Renderable cannot support normal maps (has no Tangents)
		@piece( forwardPlusApplyDecalsNormal )
			finalDecalTsNormal.xyz = normalize( finalDecalTsNormal.xyz );
			@property( normal_map_tex || detail_maps_normal )
				pixelData.normal.xy	+= finalDecalTsNormal.xy;
				pixelData.normal.z	*= finalDecalTsNormal.z;
			@end
			@property( !normal_map_tex && !detail_maps_normal )
				pixelData.normal.xyz = finalDecalTsNormal.xyz;
			@end
			//Do not normalize as later normalize( TBN * pixelData.normal ) will take care of it
		@end
	@end
@end /// hlms_enable_decals

@property( hlms_enable_cubemaps_auto )
@piece( forwardPlusDoCubemaps )
	numLightsInGrid = bufferFetch1( f3dGrid, int(sampleOffset + @value(hlms_forwardplus_cubemap_slot_offset)u) );

	@property( hlms_forwardplus_debug )totalNumLightsInGrid += numLightsInGrid;@end

	midf cubemapAccumWeight = _h( 0 );

	// Jahshaka patch 0048: HOW MANY PROBE BOXES CONTAIN THIS POINT. Not a
	// weight -- a count, and the only thing read off it is whether it is zero.
	// See the composite at the bottom of this piece.
	@property( jah_env )
		midf jahProbesHere = _h( 0 );
	@end

	midf3 pccEnvS = midf3_c( 0, 0, 0 );
	midf3 pccEnvD = midf3_c( 0, 0, 0 );

	@property( clear_coat )
		midf3 clearCoatPccEnvS = midf3_c( 0, 0, 0 );
	@end

	@property( vct_num_probes )
	if( pixelData.roughness < 1.0f || vctSpecular.w == 0 )
	{
		// Jahshaka patch 0017: accumVctLerp is now the probeFade-WEIGHTED sum of
		// each probe's PCC trust (1 - vctLerp), so that it shares pccEnvS's own
		// normalisation by cubemapAccumWeight. The unweighted probe COUNT that
		// upstream divided the whole blend by is gone -- derivation at the blend
		// itself, at the bottom of this piece.
		midf accumVctLerp = _h( 0 );
	@end
	for( uint i=0u; i<numLightsInGrid; ++i )
	{
		//Get the probe index
		uint idx = bufferFetch1( f3dGrid, int(sampleOffset + i + @value(hlms_forwardplus_cubemap_slot_offset)u + 1u) );

		CubemapProbe probe;

		probe.row0_centerX	= readOnlyFetch( f3dLightList, int(idx) ).xyzw;
		probe.row1_centerY	= readOnlyFetch( f3dLightList, int(idx + 1u) ).xyzw;
		probe.row2_centerZ	= readOnlyFetch( f3dLightList, int(idx + 2u) ).xyzw;
		probe.halfSize		= readOnlyFetch( f3dLightList, int(idx + 3u) ).xyzw;
		probe.cubemapPosLS	= readOnlyFetch( f3dLightList, int(idx + 4u) ).xyzw;
		probe.cubemapPosVS	= readOnlyFetch( f3dLightList, int(idx + 5u) ).xyzw;
		float4 probeInnerRange = readOnlyFetch( f3dLightList, int(idx + 6u) ).xyzw;
		float4 probeOuterRange = readOnlyFetch( f3dLightList, int(idx + 7u) ).xyzw;

		midf3 posInProbSpace = toProbeLocalSpace( inPs.pos, probe );
		midf probeFade = getProbeFade( posInProbSpace, probe );

		if( probeFade > _h( 0 ) )
		{
			// Jahshaka patch 0048: this probe's box contains the shaded point.
			// The test is the loop's own -- `getProbeFade > 0` is upstream's
			// statement that a probe may answer for a point at all.
			@property( jah_env )
				jahProbesHere += _h( 1.0 );
			@end
			float2 cubemapIdx_priority = unpackUshort2ToFloat2( floatBitsToUint( probe.halfSize.w ) );
			float probeCubemapIdx   = cubemapIdx_priority.x;
			float probePriority     = cubemapIdx_priority.y;

			midf3 probeToAreaCenterOffsetLS = midf3_c( probe.cubemapPosLS.w,
													   probe.cubemapPosVS.w,
													   probeInnerRange.w );
			midf ndf = getProbeNDF( posInProbSpace.xyz, probeToAreaCenterOffsetLS.xyz,
									midf3_c( probeInnerRange.xyz ), midf3_c( probeOuterRange.xyz ) );
			ndf = saturate( ndf );
			probeFade = _h( 1.0 ) - ndf;
			probeFade = probeFade * probeFade;
			probeFade = probeFade * probeFade;
			probeFade *= midf_c( probePriority );

			// ---- JAHSHAKA PATCH 0029: CAN THIS POINT SEE THE PROBE? ----------
			//
			// Owner, 2026-09-13: "why would the outside of a building show the
			// room inside? That makes zero sense to me." -- and, when the lead
			// reached for enclosure detection: "the engine should not know if
			// there is a room? Isn't it the layout of objects in a scene that
			// matters?" Exactly so. A probe is a photograph taken from a point,
			// and the only honest question is whether the shaded point is IN
			// that photograph or hidden behind something in it. Pure geometry;
			// no concept of a room required.
			//
			// The probe already captured the answer. Its cube's ALPHA is how far
			// it could see in every direction (the DepthCompressor pass), so:
			// march from the probe camera towards this pixel, read what the
			// probe saw that way, and treat "it saw something nearer" as
			// occlusion. The parallax box (getProbeFade, above) stays as the
			// cheap first rejection; this is the test that knows about geometry.
			//
			// THE SLACK IS RELATIVE, because the error is: one cube texel spans
			// a solid angle, the compressed depth is 8 bits at the LDR tiers,
			// and a texel straddling a silhouette filters between two depths.
			// 8% of the probe-to-point distance, floored at 2% of the captured
			// distance, keeps grazing floors and walls fully visible while the
			// case the owner pointed at -- the outward face of a slab whose
			// inward face the probe photographed -- fails it by 30% or more.
			midf3 probeCamPosLS   = midf3_c( probe.cubemapPosLS.xyz );
			midf3 probeToPosLS    = posInProbSpace.xyz - probeCamPosLS;
			midf  probeToPosDist  = length( probeToPosLS );
			midf3 probeToPosDirLS = probeToPosLS / max( probeToPosDist, _h( 1e-6 ) );
			// The cube is sampled LEFT HANDED (localCorrect flips z on the way
			// out); the visibility ray is flipped the same way.
			midf3 probeVisDirLS   = midf3_c( probeToPosDirLS.x, probeToPosDirLS.y,
											 -probeToPosDirLS.z );
			midf  probeVisDepth;
			@property( !hlms_cubemaps_use_dpm )
				probeVisDepth = OGRE_SampleArrayCubeLevelF16(
					texEnvProbeMap, samplerState@value(envMapRegSampler),
					float3( probeVisDirLS ), probeCubemapIdx, 0.0 ).w;
			@else
				probeVisDepth = OGRE_SampleArray2DLevelF16(
					texEnvProbeMap, samplerState@value(envMapRegSampler),
					mapCubemapToDpm( probeVisDirLS ), probeCubemapIdx, 0.0 ).w;
			@end
			midf probeSeenDist = probeCapturedDistance( probeToPosDirLS, probeCamPosLS,
														midf3_c( probe.halfSize.xyz ),
														probeVisDepth );
			// SLACK, relative, because the error is: one cube texel spans a solid
			// angle, the compressed depth is 8 bits at the LDR tiers, and a
			// texel straddling a silhouette filters between two depths. 8% of
			// the probe-to-point distance with a floor of 2% of the captured
			// distance keeps grazing floors and walls fully visible; a partition
			// with a room beyond it fails by 69% (measured).
			midf probeVisSlack = max( probeToPosDist * _h( 0.08 ),
									  probeSeenDist * _h( 0.02 ) );
			midf probeVisPass = saturate( ( probeSeenDist - probeToPosDist + probeVisSlack ) /
										   max( probeVisSlack, _h( 1e-6 ) ) );

			// ...AND ONLY A PROBE IN FRONT OF THIS SURFACE MAY BE TESTED AT ALL.
			// The thing most often standing between a probe and a shaded point
			// is THE SHADED POINT'S OWN OBJECT: a probe beside or behind a
			// mirror box photographs that box's own far face or its silhouette
			// edge, and the depth test then says "cannot see you" about a
			// surface whose only occluder is itself. Measured, in
			// gi.probe_gate's room: the chrome box's front face reads 79% of
			// its own distance from the probes behind it, and the runtime plate
			// 39% -- both indistinguishable, by depth alone, from a wall.
			// A probe behind the surface cannot be asked this question, so it
			// is not: it keeps upstream's box reprojection, which is what a
			// mirror in a sealed room lives on. A probe IN FRONT can be, and
			// there the answer is meaningful -- it is a partition, a wall, a
			// second room. The test fades in over the first quarter of the
			// cosine (full trust about 15 degrees off the tangent plane), so a
			// curved surface ramps instead of flickering along its own horizon.
			// Both vectors live in the PROBE's local space, which is view space
			// rotated, so the cosine is the same one; probeToPosDirLS runs FROM
			// the probe TO the point, so facing the probe is its negative.
			midf3x3 probeVsToLs = buildMidf3x3( probe.row0_centerX.xyz,
												probe.row1_centerY.xyz,
												probe.row2_centerZ.xyz );
			midf3 probeNormalLS = mul( pixelData.normal, probeVsToLs );
			midf probeFacing = -dot( probeNormalLS, probeToPosDirLS );
			midf probeVisWeight = saturate( probeFacing * _h( 4.0 ) );
			midf probeVisible = _h( 1.0 ) - probeVisWeight * ( _h( 1.0 ) - probeVisPass );

			// CONFIDENCE SCALES THE CONTRIBUTION, NOT THE WEIGHT -- the measured
			// trap from lane E3, and the reason this is two variables rather
			// than one. `pccEnvS` is normalised by cubemapAccumWeight at the
			// bottom of this piece, so crushing every probe's weight would only
			// renormalise the SAME probes back to full strength. So `probeFade`
			// (which multiplies every sampled term below, and patch 0017's
			// probe-trust accumulator with it) carries the visibility, while
			// cubemapAccumWeight keeps accumulating the FULL weight. The share
			// an occluded probe does not claim is then handed back by patch
			// 0017's blend to whatever filled envColourS before the probes ran
			// -- cone tracing, the irradiance field, the sky -- and never to
			// black, which is what a naive tightening of probe influence
			// produces in a sealed room.
			//
			// In the non-VCT branch at the bottom (upstream-only: Jahshaka
			// builds a probe grid in the VCT+PCC hybrid alone, so vct_num_probes
			// is always set when probes exist) there is no other environment
			// term to hand it back to, and the occluded share simply drops out.
			midf probeFadeFull = probeFade;
			probeFade = probeFade * probeVisible;

			@property( vct_num_probes )
				midf4 reflDirLS_dist = localCorrect( pixelData.reflDir, posInProbSpace, probe );
				midf3 reflDirLS = reflDirLS_dist.xyz;
			@else
				midf3 reflDirLS = localCorrect( pixelData.reflDir, posInProbSpace, probe ).xyz;
			@end
			midf3 normalLS = localCorrect( pixelData.normal, posInProbSpace, probe ).xyz;

			midf4 pccSingleEnvS;

			@property( clear_coat )
				midf3 clearCoatPccSingleEnvS;
			@end

			@property( !hlms_cubemaps_use_dpm )
				pccSingleEnvS = OGRE_SampleArrayCubeLevelF16(
					texEnvProbeMap, samplerState@value(envMapRegSampler), float3( reflDirLS ),
					probeCubemapIdx, @insertpiece( envSpecularRoughness ) );
				@property( cubemaps_as_diffuse_gi )
					pccEnvD += OGRE_SampleArrayCubeLevelF16(
						texEnvProbeMap, samplerState@value(envMapRegSampler), normalLS,
						probeCubemapIdx, 11.0 ).xyz
						@insertpiece( ApplyEnvMapScale ) * probeFade;
				@end

				@property( clear_coat )
					clearCoatPccSingleEnvS = OGRE_SampleArrayCubeLevel( texEnvProbeMap, samplerState@value( envMapRegSampler ),
																		float3( reflDirLS ),
																		probeCubemapIdx,
																		@insertpiece( envSpecularRoughnessClearCoat ) ).xyz @insertpiece( ApplyEnvMapScale );
					clearCoatPccSingleEnvS *= probeFade;
				@end
			@else
				pccSingleEnvS = OGRE_SampleArray2DLevelF16(
					texEnvProbeMap, samplerState@value(envMapRegSampler), mapCubemapToDpm( reflDirLS ),
					probeCubemapIdx, @insertpiece( envSpecularRoughness ) );
				@property( cubemaps_as_diffuse_gi )
					pccEnvD += OGRE_SampleArray2DLevelF16(
						texEnvProbeMap, samplerState@value(envMapRegSampler), mapCubemapToDpm( normalLS ),
						probeCubemapIdx, 11.0 ).xyz
						@insertpiece( ApplyEnvMapScale ) * probeFade;
				@end

				@property( clear_coat )
					clearCoatPccSingleEnvS = OGRE_SampleArray2DLevelF16( texEnvProbeMap, samplerState@value( envMapRegSampler ),
																		 mapCubemapToDpm( reflDirLS ),
																		 probeCubemapIdx,
																		 @insertpiece( envSpecularRoughnessClearCoat ) ).xyz @insertpiece( ApplyEnvMapScale );
					clearCoatPccSingleEnvS *= probeFade;
				@end
			@end

			pccSingleEnvS.xyz *= probeFade;
			@property( envmap_scale )
				pccSingleEnvS.xyz *= midf_c( passBuf.ambientUpperHemi.w );
			@end

			@property( vct_num_probes )
				float vctLerp = getPccVctBlendWeight( inPs.pos, pixelData.reflDir, reflDirLS_dist.w,
													  pixelData.roughness,
													  probe.cubemapPosVS.xyz,
													  vctSpecPosVS, vctSpecular.w,
													  passBuf.pccVctMinDistance,
													  passBuf.invPccVctInvDistance,
													  pccSingleEnvS.w );

				pccSingleEnvS *= 1.0f - vctLerp;

				@property( clear_coat )
					clearCoatPccSingleEnvS *= 1.0f - vctLerp;
				@end

				accumVctLerp += probeFade * midf_c( 1.0f - vctLerp );	// Jahshaka patch 0017
			@end

			pccEnvS	+= pccSingleEnvS.xyz;

			@property( clear_coat )
				clearCoatPccEnvS += clearCoatPccSingleEnvS;
			@end

			cubemapAccumWeight += probeFadeFull;	// Jahshaka patch 0029 -- FULL weight
		}
	}

	@property( cubemaps_as_diffuse_gi )
		pccEnvD.xyz *= cubemapAccumWeight == _h( 0.0f ) ? _h( 1.0f ) : (_h( 1.0f ) / cubemapAccumWeight);
	@end
	pccEnvS.xyz *= cubemapAccumWeight == _h( 0.0f ) ? _h( 1.0f ) : (_h( 1.0f ) / cubemapAccumWeight);

	@property( clear_coat )
		clearCoatPccEnvS *= cubemapAccumWeight == 0.0f ? 1.0f : ( 1.0f / cubemapAccumWeight );
	@end

	@property( vct_num_probes )
		// Jahshaka patch 0017 -- the overlapping-probe division fix.
		//
		// Upstream divided the finished blend by numProbesVctLerp, the COUNT of
		// probes covering this pixel:
		//     envColourS = ( pccEnvS + vct * (N - accumVctLerp) ) / N
		// but pccEnvS is ALREADY a weighted average by then (the line above
		// divides it by cubemapAccumWeight, the sum of probeFade), so dividing it
		// again by N darkens every probe reflection by however many probes happen
		// to overlap the pixel. Measured on one mirror pixel of gi.pcc_bounds
		// with geometry and placement held identical: 1 probe -> r 1.000,
		// 4 probes -> r 0.251. A 3x2x3 grid at overlap 1.5 puts a point inside up
		// to 8 probe volumes, i.e. up to 8x too dark. The non-VCT branch of this
		// very piece has no such division (envColourS.xyz = pccEnvS), and neither
		// does the single-probe path in Main/800.PixelShader_piece_ps.any, which
		// is a plain lerp( envS, vct, vctLerp ) == envS*(1-vctLerp) + vct*vctLerp.
		//
		// Derivation of the multi-probe generalisation of that lerp. Write
		// w_p = probeFade of probe p, S_p = its sampled reflection, t_p = its PCC
		// trust (1 - vctLerp_p), W = sum(w_p) = cubemapAccumWeight. The loop above
		// accumulates sum(w_p * t_p * S_p) and the line above normalises it, so
		//     pccEnvS = sum(w_p * t_p * S_p) / W
		// which IS the probe contribution at its own accumulated weight; nothing
		// further is owed to it. What is left for VCT is exactly the weight the
		// probes did not claim, with T = sum(w_p * t_p) / W the weighted mean
		// trust:
		//     envColourS = pccEnvS + vct * (1 - T)
		// One fully trusted probe collapses to S -- upstream's own single-probe
		// result -- and so do N identical fully trusted probes, with no N left
		// anywhere. T must be weighted the same way pccEnvS is or the two terms
		// do not sum to one unit of weight: upstream's unweighted count on two
		// probes with fades 1.0/0.1 and trusts 1/0 yields 0.909*S + 0.5*vct,
		// 1.41 units of light. Hence the probeFade weighting above.
		midf pccVctTrust = cubemapAccumWeight == _h( 0.0f )
						   ? _h( 0.0f )
						   : saturate( accumVctLerp / cubemapAccumWeight );
		pixelData.envColourS.xyz = pccEnvS +
								   pixelData.envColourS * ( _h( 1.0f ) - pccVctTrust );
		@property( cubemaps_as_diffuse_gi )
			pixelData.envColourD += vctSpecular.w > 0 ? midf3_c( 0, 0, 0 ) : pccEnvD;
		@end

		@property( clear_coat )
			pixelData.clearCoatEnvColourS = clearCoatPccEnvS +	// Jahshaka patch 0017
											pixelData.clearCoatEnvColourS * ( _h( 1.0f ) - pccVctTrust );
		@end
	@else
		pixelData.envColourS.xyz = pccEnvS;
		@property( cubemaps_as_diffuse_gi )
			pixelData.envColourD.xyz = pccEnvD;
		@end

		@property( clear_coat )
			pixelData.clearCoatEnvColourS = clearCoatPccEnvS;
		@end
	@end


	// ---- WHERE NO PROBE IS AND NO CONE RAN, THE SKY IS -----------------------
	// (Jahshaka patch 0048; reduced by PHOTON-ENV-1.)
	//
	// The environment slot of this pin's PBS shader has ONE occupant, and under
	// automatic parallax-corrected cubemaps it is the probe cube ARRAY: the sky
	// cubemap comes off every datablock the moment one probe exists (a manual
	// cube in that slot generates a shader that cannot compile -- OgreSky.cpp's
	// note on reflectionTexFor has the list). A PARTIAL grid is the normal case
	// (one crate in an open scene keeps 2 of 18 candidates), so a pixel no
	// surviving probe's box contains has no environment from this piece at all.
	//
	// INSIDE A VOXEL VOLUME that is already answered: the specular cone reads the
	// ONE ENVIRONMENT where it escapes (Vct_piece_ps.any, jahEnvCone in the
	// reflected direction at the cone's aperture), so the pixel keeps the cone's
	// result exactly as it is. What 0048 used to do there -- trade a flat ambient
	// the cone had added for the sky, through a hand-out of what was added -- is
	// gone with the flat ambient. What remains is the pixel the cone did NOT
	// answer (outside every volume: vctSpecular.w is 0 and upstream's ambient
	// pieces are gated off by the same test) and no probe covers: it takes the
	// sky's own lobe, from the pass slot Jahshaka's listener claims (jah_env).
	//
	// THE PROBE TEST IS THE LOOP'S OWN, AND IT IS BINARY: did any probe's box
	// contain this point (the blend weight and the box depth were both measured
	// NOT to be coverage -- gi.probe_open case 13). A pixel any probe covers
	// renders exactly what the probe gives it.
	//
	// The gain and the mip count come from our own pass float4 rather than from
	// ambientUpperHemi.w and envMapNumMipmaps: both of those are shared with the
	// probe array, whose captures must not be scaled by the Sky Light dial and
	// whose mip chain is its own. The gain is PER CHANNEL (the Sky Light's
	// intensity times its tint), as every other reader of the environment has it.
	//
	// ONLY THE SPECULAR LOBE. The diffuse half of the environment belongs to the
	// irradiance field and the cones; cubemaps_as_diffuse_gi stays masked off on
	// our side.
	@property( jah_env )
		@property( vct_num_probes )
			const bool jahNoCone = vctSpecular.w == 0;
		@else
			const bool jahNoCone = true;
		@end
		if( jahProbesHere == _h( 0.0 ) && jahNoCone )
		{
			midf3 jahSkyDirLS = mul( pixelData.reflDir, midf3x3_c( passBuf.invViewMatCubemap ) );
			// (N - 1) r (2 - r): the mip the convolution stores roughness r at (audit F3).
			midf jahSkyLod = pixelData.perceptualRoughness * ( midf_c( passBuf.jahEnv.w ) - _h( 1.0 ) ) *
							 ( _h( 2.0 ) - pixelData.perceptualRoughness );
			pixelData.envColourS.xyz = OGRE_SampleLevelF16( jahEnvCube, jahEnvSampler,
															float3( jahSkyDirLS ),
															float( jahSkyLod ) ).xyz *
									   midf3_c( passBuf.jahEnv.xyz );
			@property( clear_coat )
				midf jahSkyCoatLod = pixelData.clearCoatPerceptualRoughness *
									 ( midf_c( passBuf.jahEnv.w ) - _h( 1.0 ) ) *
									 ( _h( 2.0 ) - pixelData.clearCoatPerceptualRoughness );
				pixelData.clearCoatEnvColourS = OGRE_SampleLevelF16( jahEnvCube,
																	 jahEnvSampler,
																	 float3( jahSkyDirLS ),
																	 float( jahSkyCoatLod ) ).xyz *
												midf3_c( passBuf.jahEnv.xyz );
			@end
		}
	@end

	@property( vct_num_probes )
	}
	@end
@end
@end /// hlms_enable_cubemaps_auto

@end
