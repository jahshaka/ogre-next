float jahLobeMuT( float alpha, float mu )
{
	const float q0 = 0.0316227766, p0 = 0.2236067977;
	const float fq = clamp( ( sqrt( max( alpha, 0.001 ) ) - q0 ) / ( 1.0 - q0 ), 0.0, 1.0 ) * 31.0;
	const float fm = clamp( ( sqrt( clamp( mu, 0.05, 1.0 ) ) - p0 ) / ( 1.0 - p0 ), 0.0, 1.0 ) * 31.0;
	const int i = min( int( fq ), 30 );
	const int j = min( int( fm ), 30 );
	const float a = fq - float( i ), b = fm - float( j );
	const float t0 = mix( kJahLobeMuT[i * 32 + j], kJahLobeMuT[i * 32 + j + 1], b );
	const float t1 = mix( kJahLobeMuT[( i + 1 ) * 32 + j], kJahLobeMuT[( i + 1 ) * 32 + j + 1], b );
	return mix( t0, t1, a );
}
// `alpha` the lobe's GGX alpha, `radius` and `d` the light's source radius and distance, `mu` the cosine at the light's
// centre; returns the energy normalisation, `alphaWide` the widened alpha.
float jahSphereLightWiden( float alpha, float radius, float d, float mu, out float alphaWide )
{
	const float a = max( alpha, 0.001 );
	alphaWide = a;
	if( !( radius > 0.0 ) || !( d > radius ) )
		return 1.0;
	const float ks = kJahSphereLobeK * asin( radius / d );
	alphaWide = min( sqrt( a * a + ks * ks ), 1.0 );
	return jahLobeMuT( a, mu ) / max( jahLobeMuT( alphaWide, mu ), 1e-6 );
}
@end
