@piece( JahBrdf )
// THE DIFFUSE LOBE AND THE PUNCTUAL LIGHT'S TERMS, WRITTEN ONCE (Jahshaka,
// PHOTON-CARDS-2 part A; the CARDS-1 audit's F3). HlmsPbs's BRDF_Default
// (Main/200.BRDFs_piece_ps.any) and the surface cache's card job (Jahshaka's
// Hlms/Jahshaka/JahCardLight_cs.glsl, which lists this file by name) both call
// these functions; the card job used to carry a transcription of each.
//
// IT LIVES IN THE FORK'S OWN PBS MEDIA (Hlms/Pbs/Any, parsed by every HlmsPbs
// and reachable by name from a compute job's piece list), beside
// JahDiffuseAlbedo and for the same reason: BRDF_Default runs in EVERY HlmsPbs,
// the ones registered without Jahshaka's Hlms library included.
//
// Plain GLSL in float (the Vulkan backend is the only one this fork ships
// media for); BRDF_Default converts its midf arguments at the call.

// THE ENERGY FACTOR of the normalised Disney diffuse (Frostbite, "Moving
// Frostbite to Physically Based Rendering", Lagarde and de Rousiers): the
// grazing retro-reflection the fd90 term adds is paid back by a factor that
// runs from 1 at perceptual roughness 0 to 1 / 1.51 = 0.662 at 1. The DIRECT
// lobe carries it; the ENVIRONMENT lobe carries the lobe's exact integral
// instead (jahDiffuseAlbedo, JahDiffuseAlbedo_piece_all.any).
float jahDiffuseEnergyFactor( float perceptualRoughness )
{
	return mix( 1.0, 1.0 / 1.51, perceptualRoughness );
}

// THE NORMALISED DISNEY DIFFUSE LOBE, without the albedo and without NdotL:
// lightScatter x viewScatter x the energy factor, with
//   fd90 = 0.5 r + 2 r (V.H)^2,  scatter( x ) = 1 + ( fd90 - 1 ) ( 1 - x )^5.
// Multiplied by kD (the diffuse colour already divided by pi) and by NdotL x
// the light's irradiance it is BRDF_Default's diffuse term. At V = N — a
// surface-cache texel, which stores the view-independent diffuse — pass
// NdotV = 1 and V.H = N.H: viewScatter is then exactly 1.
float jahDisneyDiffuse( float NdotL, float NdotV, float VdotH, float perceptualRoughness )
{
	float energyBias = perceptualRoughness * 0.5;
	float energyFactor = jahDiffuseEnergyFactor( perceptualRoughness );
	float fd90 = energyBias + 2.0 * VdotH * VdotH * perceptualRoughness;
	float lightScatter = 1.0 + ( fd90 - 1.0 ) * pow( 1.0 - NdotL, 5.0 );
	float viewScatter = 1.0 + ( fd90 - 1.0 ) * pow( 1.0 - NdotV, 5.0 );
	return lightScatter * viewScatter * energyFactor;
}

// A POINT OR SPOT LIGHT'S DISTANCE ATTENUATION (IMAGE-1): the inverse square
// law with a smooth window to zero at the light's range, Karis 2013 ("Real
// Shading in Unreal Engine 4", SIGGRAPH course notes, eq. 9) with the source
// clamp Frostbite uses (Lagarde and de Rousiers 2014, section 4.4):
//     E / I = saturate( 1 - ( d / R )^4 )^2 / max( d^2, rSrc^2 )
// d the distance, R the range, rSrc the radius of the emitting source (inside
// it the light cannot get brighter). Outside the source it is 1 / d^2 times
// the window, which is above 0.99 to R / 3.76 and 0.879 at R / 2; at R it
// reaches zero with a zero slope, so no light ends in an edge.
//
// THE UNITS: a light whose intensity is I lights a surface 1 m away facing it
// exactly as a sun of intensity I lights a surface facing the sun.
//
// EVERY consumer of a point or spot light's falloff calls this: HlmsPbs's pass
// buffer lights (800.PixelShader), Forward+ (200.ForwardPlus), the surface
// cache's card job, Atom's hit decode and Photon's voxel light injection (the
// area lights take jahAreaLightAttenuation below, the same window).
// The window alone: saturate( 1 - ( d / R )^4 )^2 - the range term every light's
// falloff in this family shares.
float jahLightWindow( float d, float range )
{
	float x = d / range;
	float x2 = x * x;
	float window = clamp( 1.0 - x2 * x2, 0.0, 1.0 );
	return window * window;
}

float jahLightAttenuation( float d, float range, float sourceRadius )
{
	return jahLightWindow( d, range ) / max( d * d, sourceRadius * sourceRadius );
}

// AN AREA LIGHT'S FALLOFF (AREA-SCALE-1): a Lambertian disc of radius r and
// radiance I, seen from a point on its axis d away, gives E = pi I r^2 / ( r^2 + d^2 );
// so the reflected radiance relative to contact is r^2 / ( r^2 + d^2 ) - 1 at
// contact (an emitting plane lights a surface it touches with its own radiance),
// r^2 / d^2 far away - times the same window. The approximate area lights
// (AreaLights) call it with the disc of the rectangle's area, which is within 1 %
// of the rectangle's own form factor on its axis (gi.area_energy).
float jahAreaLightAttenuation( float d, float range, float discRadius )
{
	float r2 = discRadius * discRadius;
	return jahLightWindow( d, range ) * r2 / max( r2 + d * d, 1e-8 );
}

// The same, from the light's attenuation vector as the engine packs it:
// ( range, source radius, unused, 1 / range ) - the slots Ogre names range,
// linear, quadratic and the fork's inverse range. Jahshaka's engine writes
// setAttenuation( range, 1, sourceRadius, 0 ); nothing reads the other two.
float jahLightAttenuation( float d, vec4 attenuation )
{
	return jahLightAttenuation( d, attenuation.x, attenuation.y );
}

// A SPOT LIGHT'S CONE: 0 outside the outer angle, a falloff-shaped ramp to 1
// at the inner one. `spotParams` = ( 1 / ( cos inner/2 - cos outer/2 ),
// cos outer/2, falloff ); `spotCosAngle` = the cosine between the spot's
// direction and the direction from the light to the point.
float jahSpotAttenuation( float spotCosAngle, vec3 spotParams )
{
	float spotAtten = clamp( ( spotCosAngle - spotParams.y ) * spotParams.x, 0.0, 1.0 );
	return pow( spotAtten, spotParams.z );
}

// THE LOBE ITSELF, TOWARD ONE VIEW (PHOTON-3 stage 2): BRDF_Default's specular f_s = D Vis F - GGX D with
// alpha = max( r^2, 0.001 ) (the pixel's clamp), the height-correlated Smith visibility, F = F0 ( 1 - Fc ) +
// w Fc, Fc = ( 1 - V.H )^5 - the function JahSpecularAlbedo's table integrates: the radiance a light of irradiance E
// at cosine mu sends toward V is E mu f_s, and its cosine-weighted integral over V is mu ( F0 A + w B ). Zero
// where L or V is below the surface. The readers that know their own ray evaluate it (the ray hit, the card
// read), where the stores keep the lobe's integral.
vec3 jahSpecularLobe( vec3 N, vec3 L, vec3 V, float r, vec3 F0, float w )
{
	const float NdotL = dot( N, L );
	const float NdotV = dot( N, V );
	if( !( NdotL > 0.0 ) || !( NdotV > 0.0 ) )
		return vec3( 0.0 );
	const vec3 H = normalize( L + V );
	const float VdotH = clamp( dot( V, H ), 0.0, 1.0 );
	const float a = max( r * r, 0.001 );
	const float a2 = a * a;
	// 1 - N.H^2 by the Lagrange identity, | N x H |^2 (BRDF_Default's half-precision form): the full-precision
	// ( N.H a2 - N.H ) N.H + 1 cancels to a2 at the peak, where a polished lobe's a2 (6e-6 at r 0.05) is a few
	// float steps of 1 - its peak read 2.6 % low (gi.metal_bounce's law).
	const vec3 NxH = cross( N, H );
	const float f = a2 + dot( NxH, NxH ) * ( 1.0 - a2 );
	const float D = a2 / ( 3.141592654 * f * f );
	const float lv = NdotL * sqrt( ( -NdotV * a2 + NdotV ) * NdotV + a2 );
	const float ll = NdotV * sqrt( ( -NdotL * a2 + NdotL ) * NdotL + a2 );
	const float vis = 0.5 / ( lv + ll + 1e-6 );
	const float fc = pow( 1.0 - VdotH, 5.0 );
	return ( D * vis ) * ( F0 * ( 1.0 - fc ) + vec3( w * fc ) );
}

// A SPHERE LIGHT'S SPECULAR (PHOTON-7 stage 11): a lamp has a size, and its glint carries the point's energy - only its
// distribution widens. The lobe toward the light's CENTRE is widened to alpha'^2 = alpha^2 + ( k s )^2, s = asin( R / d )
// the sphere's angular radius, k = 0.777 so the GGX half-maximum in reflected angle (1.287 alpha') falls on the disc's
// edge s; and SCALED so its energy equals the point lobe's by construction: norm = T( alpha, mu ) / T( alpha', mu ), with
// T( alpha, mu ) = the integral over view directions of D Vis (GGX, the height-correlated Smith visibility) for a light at
// cosine mu - the glint's image-space energy per unit irradiance. T comes from the table below (mu T, 32 x 32 over
// sqrt( alpha ) in [ sqrt( 0.001 ), 1 ] and sqrt( mu ) in [ sqrt( 0.05 ), 1 ], computed by quadrature: Jahshaka's
// spikes/photon-7/stage11/glint-energy/table.py; bilinear within 0.4 %). Karis's representative point, built first, carried
// 0.92 - 1.64 x the point's energy (on a mirror an extra 1 / cos V): a different picture, replaced. The ONE function every
// reader of a punctual light's glint takes - the pixel's BRDF_Default and the ray hits: one answer for one light. A light of
// no size returns alpha and 1. INSIDE THE HIGHLIGHT the shape is a GGX blob where a mirror's exact image of a sphere is a
// flat disc; its energy and its extent are the sphere's.
const float kJahSphereLobeK = 0.777;
const float kJahLobeMuT[1024] = float[1024](
	1.003559, 1.002664, 1.001423, 1.001377, 1.001844, 1.000844, 1.000518, 1.000369, 1.000278, 1.000217, 1.000173,
