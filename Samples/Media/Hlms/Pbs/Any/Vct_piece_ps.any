#include "/media/matias/Datos/SyntaxHighlightingMisc.h"

@property( vct_num_probes )

@piece( DeclVctTextures )
	@property( syntax == glsl || syntax == glslvk )
		vulkan_layout( ogre_t@value(vctProbes) ) uniform texture3D vctProbes[@value( vct_num_probes )];
		vulkan( layout( ogre_s@value(vctProbes) ) uniform sampler vctProbeSampler );
		@property( vct_anisotropic )
			vulkan_layout( ogre_t@value(vctProbeX) ) uniform texture3D vctProbeX[@value( vct_num_probes )];
			vulkan_layout( ogre_t@value(vctProbeY) ) uniform texture3D vctProbeY[@value( vct_num_probes )];
			vulkan_layout( ogre_t@value(vctProbeZ) ) uniform texture3D vctProbeZ[@value( vct_num_probes )];
		@end
		// THE CONE FUNCTIONS COME AFTER THE VOLUMES THEY READ (PHOTON-READER-1): the
		// march reads the volumes as globals through its macro convention, and this
		// piece is the first point in the pixel shader where they are declared
		// (DeclVctFuncs is inserted earlier, with the pass-buffer helpers).
		@insertpiece( DeclVctConeFuncs )
	@end
	@property( syntax == hlsl )
		Texture3D vctProbes[@value( vct_num_probes )]		: register(t@value(vctProbes));
		SamplerState vctProbeSampler	: register(s@value(vctProbes));
		@property( vct_anisotropic )
			Texture3D vctProbeX[@value( vct_num_probes )]	: register(t@value(vctProbeX));
			Texture3D vctProbeY[@value( vct_num_probes )]	: register(t@value(vctProbeY));
			Texture3D vctProbeZ[@value( vct_num_probes )]	: register(t@value(vctProbeZ));
		@end
	@end
	@property( syntax == metal )
		, array<texture3d<float> vctProbes, @value( vct_num_probes )>	[[texture(@value(vctProbes))]]
		, sampler vctProbeSampler			[[sampler(@value(vctProbes))]]
		@property( vct_anisotropic )
			, array<texture3d<float> vctProbeX, @value( vct_num_probes )>	[[texture(@value(vctProbeX))]]
			, array<texture3d<float> vctProbeY, @value( vct_num_probes )>	[[texture(@value(vctProbeY))]]
			, array<texture3d<float> vctProbeZ, @value( vct_num_probes )>	[[texture(@value(vctProbeZ))]]
		@end
	@end
@end

@piece( DeclVctFuncs )
	/// Jahshaka patch 0083: THE CONE BASIS IS A FUNCTION OF THE NORMAL AND OF
	/// NOTHING ELSE. `buildConeBasis` returns an orthonormal frame whose third
	/// axis is `n`, built by Frisvad's method (JGT 2012) -- continuous over the
	/// whole sphere but for ONE direction, where the branch below hands back a
	/// fixed frame instead of dividing by zero.
	///
	/// `n` is expected in a CAMERA-INDEPENDENT space (the caller hands it the
	/// normal taken to cubemap space), because a frame is only worth building
	/// once it cannot turn with the head.
	///
	/// AND IT IS BUILT ABOUT THAT SPACE'S OWN AXES, which is a decision that was
	/// measured rather than argued. Frisvad's construction is written about
	/// (0,0,1) and its one special direction is the antipode, so a fixed
	/// pre-rotation would move that direction anywhere -- onto a body diagonal,
	/// say, which no axis-aligned surface has. That was tried, and it COSTS
	/// LIGHT: the six cones of an axis-aligned surface then all point at odd
	/// angles, where every sample is a three-way blend of the anisotropic voxel
	/// volumes instead of a near-direct read of one, and the bounce comes out
	/// systematically dimmer. Measured on gi.field_follows' own bar -- the red a
	/// wall bounces onto grey ground beyond cascade 0 -- 0.0174 with the axes,
	/// 0.0105 with the body diagonal: forty per cent of the bounce, gone, on
	/// every surface in every scene.
	///
	/// WHAT THAT BUYS AND WHAT IT COSTS. Keeping the axes keeps the common case
	/// (walls, floors, ceilings) on the voxel volumes' own axes. The price is
	/// that the special direction is a world axis: a surface whose normal is
	/// within a hair of it takes the branch's fixed frame while its neighbours
	/// take a rapidly turning one. The two properties cannot be separated --
	/// "the frame is axis-aligned for axis normals" and "the reference direction
	/// is an axis" are the same statement -- so this is a trade, and it is made
	/// on the side the measurement points to.
	///
	/// The two frames this REPLACES were both unstable, and the instability is
	/// visible because the diffuse cone set is not azimuthally symmetric against
	/// an anisotropic voxel field: rotate the frame about the normal and the six
	/// cones read different axis volumes.
	///   * the material's TANGENT frame (what the normal_map permutations used):
	///     a per-VERTEX attribute authored for texturing, interpolated from a
	///     different vertex triple in each triangle of a quad, so one flat face
	///     shaded as two triangles with a hard kink along its own diagonal, with
	///     per-pixel grain across each, and the same box shaded differently after
	///     being turned on its own axis.
	///   * the DDX fallback (what the rest used), whose own comment above said it
	///     "isn't fully stable due to how DDX works and due to floating point
	///     precision".
	INLINE float3x3 buildConeBasis( float3 n )
	{
		float3 t;
		float3 b;
		if( n.z < -0.9999999 )
		{
			t = float3( 0.0, -1.0, 0.0 );
			b = float3( -1.0, 0.0, 0.0 );
		}
		else
		{
			float a = 1.0 / ( 1.0 + n.z );
			float c = -n.x * n.y * a;
			t = float3( 1.0 - n.x * n.x * a, c, -n.x );
			b = float3( c, 1.0 - n.y * n.y * a, -n.y );
		}
		return buildFloat3x3( t, b, n );
	}


	INLINE float3 toVctProbeSpacePos( float3 pos, VctProbeParams probeParams )
	{
		float3 posLS;
		posLS.x = dot( probeParams.xform_row0.xyzw, float4( pos, 1.0 ) );
		posLS.y = dot( probeParams.xform_row1.xyzw, float4( pos, 1.0 ) );
		posLS.z = dot( probeParams.xform_row2.xyzw, float4( pos, 1.0 ) );
		return posLS;
	}

	INLINE float3 toVctProbeSpaceDir( float3 dir, VctProbeParams probeParams )
	{
		float3 dirLS;
		dirLS.x = dot( probeParams.xform_row0.xyz, dir );
		dirLS.y = dot( probeParams.xform_row1.xyz, dir );
		dirLS.z = dot( probeParams.xform_row2.xyz, dir );
		return normalize( dirLS );
	}


	INLINE float3 fromVctToViewSpace( float3 pos, VctProbeParams probeParams )
	{
		float3 posVS;
		posVS.x = dot( probeParams.invXform_row0.xyzw, float4( pos, 1.0 ) );
		posVS.y = dot( probeParams.invXform_row1.xyzw, float4( pos, 1.0 ) );
		posVS.z = dot( probeParams.invXform_row2.xyzw, float4( pos, 1.0 ) );
		return posVS;
	}



	#define M_PI 3.141592654f

	INLINE float getPccVctBlendWeight( float3 inPsPos, float3 reflDir, float fDist,
									   float roughness, float3 cubemapPosVS,
									   float3 vctSpecPosVS, float vctSpecularW,
									   float pccVctMinDistanceVar, float invPccVctInvDistanceVar,
									   float pccCompressedDepth )
	{
		//Calculate interesectionPosVS as the intersection between the reflection ray and a cube
		float3 interesectionPosVS = inPsPos + reflDir * fDist;

		//Now increase interesectionPosVS accuracy (it will no longer be a box)
		//by taking the compressed PCC depth stored in pccCompressedDepth
		//The compressed PCC depth is in the form of:
		//	interesectionPosVS = cubemapPosVS + reflDirLS * (pccCompressedDir * 2.0);
		interesectionPosVS = cubemapPosVS.xyz +
							 (interesectionPosVS - cubemapPosVS.xyz) * (pccCompressedDepth * 2.0);
		float3 vctSpecPosToPccSpecPos = interesectionPosVS - vctSpecPosVS;
		//Calculate distance to VCT pos and blend based on that
		float distToVct = max3( abs( vctSpecPosToPccSpecPos ).x,
								abs( vctSpecPosToPccSpecPos ).y,
								abs( vctSpecPosToPccSpecPos ).z );
		float vctLerp = (distToVct - pccVctMinDistanceVar) * invPccVctInvDistanceVar;
		vctLerp = saturate( vctLerp );

		//vctLerp has quantization artifacts due to 8-bit precision when interpolating via HW
		//texture filtering present in vctSpecPosVS. They're very noticeable at non-zero roughness.
		//Hide these artifacts by reusing the PCC compressed depth as a mask.
		float pccErrorMask = ( pccCompressedDepth - 0.5f ) * ( pccCompressedDepth - 0.5f ) * 4.0f;
		float roughThreshWeight = roughness - 0.02f;
		roughThreshWeight = min( roughThreshWeight * 200.0f, 1.0f );
		vctLerp = lerp( vctLerp, vctLerp * pccErrorMask, roughThreshWeight );

		//At very high roughness, VCT (anisotropic) is much more accurate. Thus bias towards VCT
		vctLerp = min( vctLerp + roughness * roughness * roughness, 1.0f );

		//If no VCT probe was found, fallback to PCC
		vctLerp = (vctSpecularW == 0) ? 0.0f : vctLerp;

		return vctLerp;
	}
@end

@piece( DeclVctConeFuncs )
	// THE ONE VOXEL RADIANCE READER, BOUND TO THE PIXEL SHADER (PHOTON-READER-1).
	// The cone march this piece used to hold — and its twin in the bounce job and
	// the third one in the irradiance field's generation job — is now ONE pair of
	// plain-GLSL files, irisgl/engine/src/rayquery/include/jah_voxel_sample.glsl
	// and jah_voxel_march.glsl, that Jahshaka's build wraps into the library pieces
	// JahVoxelSample and JahVoxelMarch (Hlms/Jahshaka). Every rule of the march
	// and the fork change that made it (the age carry, the escape estimate, the
	// one-cell hop bias, the single transmittance) is written there once. What is
	// left here is the binding: which volumes, which pass-buffer members.
	#define JAH_VOX_MAX_CASCADES @value( vct_num_probes )
	#define JAH_VOX_COUNT @value( vct_num_probes )
	#define JAH_VOX_SAMPLE_ISO( c, u, l ) OGRE_SampleLevel( vctProbes[c], vctProbeSampler, u, l )
	@property( vct_anisotropic )
		#define JAH_VOX_HAS_ANISO 1
		#define JAH_VOX_ANISO true
		#define JAH_VOX_SAMPLE_X( c, u, l ) OGRE_SampleLevel( vctProbeX[c], vctProbeSampler, u, l )
		#define JAH_VOX_SAMPLE_Y( c, u, l ) OGRE_SampleLevel( vctProbeY[c], vctProbeSampler, u, l )
		#define JAH_VOX_SAMPLE_Z( c, u, l ) OGRE_SampleLevel( vctProbeZ[c], vctProbeSampler, u, l )
	@else
		#define JAH_VOX_HAS_ANISO 0
		#define JAH_VOX_ANISO false
	@end
	#define JAH_VOX_INVRES( c ) passBuf.vctProbeParams.vctInvResolution_cascadeMaxLod[c].xyz
	#define JAH_VOX_MAXLOD( c ) passBuf.vctProbeParams.vctInvResolution_cascadeMaxLod[c].w
	@property( vct_num_probes > 1 )
		#define JAH_VOX_FROM_PREV_SCALE( c ) passBuf.vctProbeParams.fromPreviousProbeToNext[(c) - 1][0]
		#define JAH_VOX_FROM_PREV_OFFSET( c ) passBuf.vctProbeParams.fromPreviousProbeToNext[(c) - 1][1]
	@end
	@property( vct_enable_specular_sdf_quality && vct_num_probes <= 1 )
		#define JAH_VOX_SDF_MAXMIP passBuf.vctProbeParams.specSdfMaxMip
		#define JAH_VOX_SDF_FACTOR passBuf.vctProbeParams.specularSdfFactor
	@end
	@insertpiece( JahVoxelSample )
	@insertpiece( JahVoxelMarch )

	// THE ONE ENVIRONMENT, BOUND TO THE PIXEL SHADER (PHOTON-ENV-1). What every
	// escape sees - a diffuse cone's, the specular cone's, and the fallbacks the
	// irradiance field and the screen-probe gather hand a pixel - is ONE plain-GLSL
	// file, irisgl/engine/src/rayquery/include/jah_environment.glsl, wrapped by
	// Jahshaka's build into the library piece JahEnvironment: the disc-free sky
	// cube read at the mip whose lobe matches the cone, or (no cube bound) the SH
	// in the cone's direction. The cube and its gain come from the pass slot
	// Jahshaka's Hlms listener claims (jah_env); the SH is HlmsPbs's own, whose
	// frame is the world turned half a turn about Y (OgreScene::setAmbientSh).
	// This replaces the two-band hemisphere pair every escape used to be filled
	// with (the pair is gone from VctLighting and from this pass buffer).
	@property( jah_env )
		#define JAH_ENV_CUBE_ON true
		#define JAH_ENV_SAMPLE( d, l ) float3( OGRE_SampleLevelF16( jahEnvCube, jahEnvSampler, d, l ).xyz )
		#define JAH_ENV_MIPS passBuf.jahEnv.w
		#define JAH_ENV_GAIN passBuf.jahEnv.xyz
	@else
		#define JAH_ENV_CUBE_ON false
		#define JAH_ENV_SAMPLE( d, l ) float3( 0, 0, 0 )
		#define JAH_ENV_MIPS 1.0
		#define JAH_ENV_GAIN float3( 0, 0, 0 )
	@end
	@property( ambient_sh )
		#define JAH_ENV_SH( n ) float3( irradianceSH( float3( -( n ).x, ( n ).y, -( n ).z ) PASSBUF_ARG ) )
	@else
		#define JAH_ENV_SH( n ) float3( 0, 0, 0 )
	@end
	@insertpiece( JahEnvironment )

	/// A view-space direction in WORLD axes: the camera-independent frame the
	/// environment is stored in. `invViewMatCubemap` read vector-first takes a
	/// view-space direction to the left-handed cubemap frame (the same line the
	/// env-probe piece uses); undoing the frame's z flip gives the world.
	INLINE float3 jahViewToWorldDir( float3 dirVS )
	{
		float3 c = mul( dirVS, passBuf.invViewMatCubemap );
		return float3( c.x, c.y, -c.z );
	}

	INLINE void computeVctProbe
	(
		OGRE_INOUT_REF( float3, outDiffuse ), OGRE_INOUT_REF( float4, outSpecular ),
		PixelData pixelData, float3 pos, float3x3 TBN,
	@property( use_parallax_correct_cubemaps )
		OGRE_INOUT_REF( float3, vctSpecPosVS ),
	@end
		VctProbeParams probeParams
	)
	{
		float3 posLS = toVctProbeSpacePos( pos, probeParams );

		// Bias away from current position in order to avoid self-occlusion (specular reflections
		// won't work otherwise).
		//
		// JAHSHAKA PATCH 0070 - ONE CELL, WHICHEVER WAY THE SURFACE FACES.
		//
		// Upstream wrote `(dirLS / maxVal) * vctInvResolution * lerp( 15.0f, 1.0f, maxVal )`,
		// where maxVal is the largest component of the normal in probe space: 1 for a
		// normal down an axis and 1/sqrt(3) = 0.577 for a body-diagonal one. That makes
		// the bias ONE voxel for an axis-aligned surface and lerp(15,1,0.577)/0.577 =
		// TWELVE voxels for a diagonal one - 8 cm against 94 cm on a 7.8 cm cascade. The
		// stated reason is staircase aliasing on axis-aligned steps, and on a box it is
		// invisible because every face has maxVal 1.
		//
		// On a CURVED surface it is a seam by construction. A sphere's normal sweeps
		// every direction, so the start point of every cone - the six diffuse ones and
		// the specular one - travels from one voxel to twelve and back across the six
		// arcs where two components of the normal are equal in magnitude. A downward
		// diagonal normal on the lower half of a sphere starts its specular cone most of
		// a metre INSIDE the floor and reads the floor's contact shadow; the upward one
		// beside it starts above the sphere's own lit voxels and reads those. A bright
		// warped streak beside a dark smear, curved along the arc - which is what the
		// owner's smoke of push 41 reported on a plain sphere in an empty scene, at a
		// roughness where the screen-space and ray-traced arms are both gated off and
		// this cone IS the whole reflection.
		//
		// The bias is a geometric statement - "leave the surface's own voxel before
		// sampling" - and a geometric statement cannot depend on how the surface happens
		// to sit against the lattice. So: ONE CELL along the normal, measured along the
		// normal, everywhere. An axis-aligned surface is unchanged (it always got one);
		// everything else stops sweeping.
		//
		// THE STEP IS COMPONENTWISE, which is the whole of "one cell" and is not a
		// detail. `vctInvResolution_cascadeMaxLod[i].xyz` is the inverse RESOLUTION per
		// axis, so multiplying a UNIT direction by it componentwise gives a displacement
		// whose length is exactly one cell for every direction on an isotropic volume,
		// and the natural per-axis cell on an anisotropic one. Taking a SCALAR step of
		// `dot( abs( d ), invRes )` instead - the obvious-looking "the cell size along
		// this direction" - is the L1 norm, which is one cell down an axis and sqrt(3) =
		// 1.73 cells along a body diagonal: a smaller sweep than upstream's twelve, but
		// the same defect, and a sphere would still band along the same six arcs. This
		// is also exactly what the bounce-injection compute twin does
		// (LightVctBounceInject_piece_cs.any, `geomNormal * p_invVoxelResolution`), so
		// the two marches finally agree.
		float3 dirLS = toVctProbeSpaceDir( pixelData.geomNormal.xyz, probeParams );
		// The normal as a DIRECTION in probe space, so the step below is a length in
		// cells rather than a length in "whatever component happened to be biggest".
		float3 biasDirLS = dirLS * ( 1.0f / max( length( dirLS ), 1e-6f ) );
		posLS += biasDirLS * probeParams.vctInvResolution_cascadeMaxLod[0].xyz;

		@property( vct_num_probes > 1 )
			/*float3 blendv = abs( posLS * 2.0f - 1.0f );
			float blend = saturate( 1.0f - max3( blendv.x, blendv.y, blendv.z ) );*/
			float blend = 1.0f;
		@else
			float blend = 1.0f;
		@end

		@property( !vct_disable_diffuse )
			@property( vct_cone_dirs == 6 )
				float3 cone_dirs[6] =
					OGRE_ARRAY_START( float3 )
						float3( 0.0, 0.0, 1.0 ),
						float3( 0.866025, 0.0, 0.5 ),
						float3( 0.267617, 0.823639, 0.5 ),
						float3( -0.700629, 0.509037, 0.5 ),
						float3( -0.700629, -0.509037, 0.5 ),
						float3( 0.267617, -0.823639, 0.5 )
					OGRE_ARRAY_END;

				float coneWeights[6] = OGRE_ARRAY_START( float ) 0.25, 0.15, 0.15, 0.15, 0.15, 0.15 OGRE_ARRAY_END;
				float coneAngleTan = 0.577;
			@else
				float3 cone_dirs[4] =
					OGRE_ARRAY_START( float3 )
						float3( 0.707107, 0.0, 0.707107 ),
						float3( 0.0, 0.707107, 0.707107 ),
						float3( -0.707107, 0.0, 0.707107 ),
						float3( 0.0, -0.707107, 0.707107 )
					OGRE_ARRAY_END;

				float coneWeights[4] = OGRE_ARRAY_START( float ) 0.25, 0.25, 0.25, 0.25 OGRE_ARRAY_END;
				float coneAngleTan = 0.98269;
			@end

			//Radiance / diffuse
			float3 light = float3( 0.0f, 0.0f, 0.0f );
			// THE ENVIRONMENT EACH CONE ESCAPES TO, in radiance (not in the voxel
			// volume's normalised units, so it is added after the decode below).
			float3 jahEnvD = float3( 0.0f, 0.0f, 0.0f );
			for( int i=0; i<@value( vct_cone_dirs ); ++i )
			{
				float3 dirVS = mul( TBN, cone_dirs[i] );
				float3 dir = toVctProbeSpaceDir( dirVS, probeParams );

				// THE WHOLE WALK, cascade 0 and every hop out (JahVoxelMarch; the
				// rules and their fork-change numbers are in its header).
				JahConeResult result = jahConeMarch( posLS, dir, coneAngleTan, biasDirLS, dirLS,
				@property( vct_cone_dirs == 4 )
													 JAH_MARCH_LODSTEP );
				@else
													 0u );
				@end

				light += coneWeights[i] * result.colour;
				// THE ESCAPE: the share of this cone the voxels did not stop (the
				// ESCAPE opacity, not the colour's - they differ only where the
				// anisotropic volumes are read; JahVoxelMarch, the escape estimate)
				// sees the environment IN THIS CONE'S DIRECTION AT THIS CONE'S
				// APERTURE. Not the normal's SH, and not a two-band pole
				// approximation of it: a cone that looks at the horizon glow sees
				// the horizon glow.
				jahEnvD += coneWeights[i] * ( 1.0f - min( 1.0f, result.escapeAlpha / 0.95f ) ) *
						   jahEnvCone( jahViewToWorldDir( dirVS ), coneAngleTan );
			}
		@end

		float blendWeight = probeParams.blendFade * blend * probeParams.multiplier;

		@property( !vct_disable_diffuse )
			// The voxels' share decoded by the volume's multiplier; the
			// environment's share is radiance already.
			outDiffuse.xyz += light.xyz * blendWeight + jahEnvD * ( probeParams.blendFade * blend );
		@end

		//Irradiance / specular
		@property( !vct_disable_specular )
			float3 reflVecLS = toVctProbeSpaceDir( pixelData.reflDir, probeParams );
			// 1 / (1 - 0.02) = 1.020408163
			float vctRoughness = (pixelData.perceptualRoughness - 0.02f) * 1.020408163f;
			float specConeAngleTan = max( 0.0f, tan( vctRoughness * 0.5f * M_PI * 0.99f ) );
			JahConeResult irrLight = jahConeMarch( posLS, reflVecLS, specConeAngleTan, biasDirLS,
												   reflVecLS,
			@property( vct_enable_specular_sdf_quality && vct_num_probes <= 1 )
												   JAH_MARCH_SPECULAR | JAH_MARCH_GAP_ALONG_DIR |
													   JAH_MARCH_SDF );
			@else
												   JAH_MARCH_SPECULAR | JAH_MARCH_GAP_ALONG_DIR );
			@end

			float specAlpha = ( 1.0f - min( 1.0f, irrLight.alpha / 0.95f ) );

			// THE SPECULAR CONE'S ESCAPE SEES THE ENVIRONMENT IN THE REFLECTED
			// DIRECTION AT THE CONE'S OWN APERTURE (PHOTON-ENV-1) - the rule that
			// ogre-patch 0048 used to apply downstream as a swap (the cone added a
			// flat ambient, exported what it added, and the probe piece traded it
			// for the sky). Radiance, weighted by the share of the cone the voxels
			// did not stop, beside the voxels' own share decoded by the volume's
			// multiplier.
			float3 jahEnvS = jahEnvCone( jahViewToWorldDir( pixelData.reflDir ), specConeAngleTan ) *
							 specAlpha;

			// JAHSHAKA PATCH 0077: THE FUDGE IS GONE, AT ITS CAUSE.
			// Upstream's comment here read "0.31831 = 1 / PI, but I'm not sure why
			// is it even needed. It's clearly overbrightened when it's not there".
			// It was needed because the light injection stored PI times the
			// surface's outgoing radiance (LightInjection_piece_cs.any: the direct
			// term had no 1/PI), so every cone result -- diffuse and specular
			// alike -- came back PI times too bright. The diffuse composite above
			// never carried the correction and was therefore PI times too bright
			// for as long as this line hid the same error on the specular one.
			// With the injection fixed the voxel holds radiance, a specular cone
			// returns radiance, and the pre-integrated BRDF downstream wants
			// exactly that: no factor.
			outSpecular += float4( irrLight.colour.xyz * blendWeight +
								   jahEnvS * ( probeParams.blendFade * blend ), blend );

			@property( use_parallax_correct_cubemaps )
				vctSpecPosVS = fromVctToViewSpace( irrLight.posLS.xyz, probeParams );
			@end
		@else
			outSpecular.w += blend;
		@end
	}

@end


@piece( applyVoxelConeTracing )
	// Jahshaka patch 0083: the cones get their own frame, and THE FRAME IS
	// ANCHORED IN THE WORLD, not in the camera.
	//
	// Everything in this shader is in VIEW space -- the vertex shader
	// multiplies the normal by worldView, and the voxel transform
	// (VctLighting's xform = voxel * view^-1) takes view-space directions to
	// voxel space -- so a frame built from `pixelData.geomNormal` as it stands
	// would turn about the normal with the camera's own rotation. For a level
	// camera the floor's tangent would simply BE the camera's right vector, and
	// the bounce would swim as you orbit and move on every head turn in VR.
	// That is a worse defect than the one this patch is here to fix, and it is
	// not one the material tangent frame had: a tangent is a world-attached
	// vertex attribute that merely arrives rotated into view space.
	//
	// `passBuf.invViewMatCubemap` is the inverse view rotation (with Ogre's
	// left-handed cubemap z flip) and is in every non-caster Pbs pass buffer,
	// which is exactly the set of passes this piece runs in. Read
	// vector-first it takes a view-space direction to that camera-independent
	// space -- the same line the env-probe piece uses a few hundred lines below
	// -- and read matrix-first it brings one back, the matrix being orthogonal.
	// So the frame is built out there and composed back in ONCE, which leaves
	// the cone loop and every other reader of this matrix untouched.
	float3x3 jahConeToView = passBuf.invViewMatCubemap;
	float3x3 jahConeBasis =
		mul( jahConeToView,
			 buildConeBasis( mul( float3( pixelData.geomNormal ), jahConeToView ) ) );

	@property( use_parallax_correct_cubemaps )
		float3 vctSpecPosVS = float3( 0, 0, 0 );
	@end

	float3 vctDiffuse = float3( 0, 0, 0 );
	float4 vctSpecular = float4( 0, 0, 0, 0 );
	computeVctProbe( vctDiffuse, vctSpecular,
					 pixelData, inPs.pos, jahConeBasis,
				@property( use_parallax_correct_cubemaps )
					 vctSpecPosVS,
				@end
					 passBuf.vctProbeParams );

	@property( !vct_disable_diffuse )
		@property( irradiance_field )
			// Jahshaka patch 0045: an irradiance field over PART of what the
			// cones cover. With a cascade chain the field rides the innermost
			// cascade only, so the cone diffuse is the answer for every pixel
			// the field cannot reach and the two must be blended rather than
			// one of them chosen scene-wide. The blend is by the field's own
			// confidence and it lives in Jahshaka's JahIfd piece, which runs
			// immediately after this one, in this same scope, and reads
			// `vctDiffuse` from here.
			//
			// Nothing changes for upstream's own arrangement: with one volume
			// HlmsPbs sets vct_disable_diffuse for any bound field and this
			// whole block is absent from the generated shader.
		@else
			pixelData.envColourD.xyz += vctDiffuse.xyz;
		@end
	@end
	@property( !vct_disable_specular )
		pixelData.envColourS.xyz += vctSpecular.xyz;
	@end
@end

@end
