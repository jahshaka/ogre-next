// NPR = Non-Physically-based Rendering Atmo
//
// This file is used by both Hlms and low level materials
// Which is why Hlms syntax is in comments

//#include "SyntaxHighlightingMisc.h"

// @property( atmosky_npr )

#ifdef HEADER

float getSunDisk( const float LdotV, const float sunY, const float sunPower )
{
    return pow( LdotV, lerp( 4.0f, 8500.0f, sunY ) * 0.25f ) * sunPower;
}

// The rest of the sky's arithmetic (the Rayleigh-inspired absorption, the
// colour gradient, the mie term) lives in the shared file below.
#include "AtmosphereNprSkyRadiance_piece_all.any"

#else

float3 atmoCameraDir = normalize( inPs.cameraDir );

const float LdotV = max( dot( atmoCameraDir, p_sunDir ), 0.0f );

// The sky's radiance for this direction is ONE text, shared with the Hlms
// (Hlms/Common/Any/AtmosphereNprSkyRadiance_piece_all.any, included in the
// header section above); only the sun disc is the sky quad's own.
float3 atmoColour = atmoNprSkyRadiance(
	atmoCameraDir, p_cameraDisplacement.xyz, p_sunDir, p_borderLimit, p_densityDiffusion,
	p_densityCoeff, p_sunHeight, p_sunHeightWeight, p_lightDensity, p_skyColour, p_sunAbsorption,
	p_skyLightAbsorption, p_mieAbsorption, p_finalMultiplier, false );

const float sunDisk = getSunDisk( LdotV, p_sunHeight, p_sunPower );
atmoColour += sunDisk * p_skyLightAbsorption;

#endif

// @end !atmosky_npr
