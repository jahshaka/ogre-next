
//#include "SyntaxHighlightingMisc.h"

@piece( HeaderCS )
	#define LT_DIRECTIONAL 0.0f
	#define LT_SPOTLIGHT 2.0f
	#define LT_AREA_LTC 5.0f

	struct Light
	{
		//Pre-mul by PI? -No because we lose a ton of precision
		//.w contains lightSqDistThreshold
		float4 diffuse;
		//For directional lights, pos.xyz contains -dir.xyz and pos.w = 0;
		//For the rest of lights, pos.xyz contains pos.xyz and pos.w = 1;
		float4 pos;
		//uvwPos.w contains the light type
		float4 uvwPos;

		//Used by area lights
		//points[0].w contains double sided info
		//points[1].w contains lightStraightDir.x
		//points[2].w contains lightStraightDir.y
		//points[3].w contains lightStraightDir.z
		float4 points[4];
	};

	@property( syntax != metal )
		CONST_BUFFER( LightBuf, 0 )
		{
			Light lights[16];
		};
	@end

	#define lightSqDistThreshold diffuse.w
	#define lightType uvwPos.w
	#define spotDirection points[0].xyz
	#define spotParams points[1]
	// JAHSHAKA PATCH 0077: 1 / PI, WHICH IS WHAT THE NAME SAYS.
	// Upstream defined `c_invPI` as PI and never used it. The direct term below
	// needs exactly this factor -- see the unit chain there.
	#define c_invPI 0.318309886f

	@insertpiece( DeclAreaLtcLightFuncs )
	// Jahshaka (PHOTON-WRITER-1): the diffuse lobe's directional albedo, the
	// function the pixel's environment lobe reads (jah_diffuse_albedo.glsl).
	@insertpiece( JahDiffuseAlbedo )
	@insertpiece( DeclSRgbFuncs )
	// JAHSHAKA PATCH 0080: THE STORE'S ENCODING FOLLOWS ITS FORMAT.
	// `uav0_orig_pf_srgb` is the property HlmsComputeJob derives from the pixel
	// format of the texture actually bound, so this one branch covers both
	// stores: an 8-bit UNORM_SRGB volume is written through the sRGB encode --
	// which is the dark-end precision an 8-bit store lives on -- and a float one
	// is written LINEAR. A format with no fixed range has no transfer function to
	// apply, and encoding into one would throw away the headroom it is there for
	// (the encode saturates nothing, but toSRGB of a value above 1 is above 1 and
	// the UNORM write clamps it -- which is the clip this patch removes).
	@property( uav0_orig_pf_srgb )
		#define jahStoreLight( x ) toSRGB( x )
	@else
		#define jahStoreLight( x ) ( x )
	@end
	// JAHSHAKA PATCH 0080: the DIRECT volume keeps its 8-bit sRGB store and so
	// keeps its encode -- D is normalised to at most the ceiling by construction
	// (VctLighting::update's auto multiplier), so nothing about it needs range.
	@property( uav1_orig_pf_srgb )
		#define jahStoreDirect( x ) toSRGB( x )
	@else
		#define jahStoreDirect( x ) ( x )
	@end
@end

//in uvec3 gl_NumWorkGroups;
//in uvec3 gl_WorkGroupID;
//in uvec3 gl_LocalInvocationID;
//in uvec3 gl_GlobalInvocationID;
//in uint  gl_LocalInvocationIndex;

@piece( BodyCS )
//	Aabb voxelAabb;
//	voxelAabbCenter	= p_voxelOrigin + p_voxelCellSize * (float3( gl_GlobalInvocationID.xyz ) + 0.5f);
//	voxelAabb.halfSize	= p_voxelCellSize * 0.5f;

//	float3 voxelUvwPos = ;

	//All lights are offsetted by p_voxelOrigin so that we don't
	//have to do this calculation per cell
	float3 voxelAabbCenter = /*p_voxelOrigin +*/
							 p_voxelCellSize * (float3( gl_GlobalInvocationID.xyz ) + 0.5f);
	float3 voxelUvwPos = p_invVoxelResolution * (float3( gl_GlobalInvocationID.xyz ) + 0.5f);

	float4 albedoVal = OGRE_Load3D( voxelAlbedoTex, gl_GlobalInvocationID.xyz, 0 );
	float4 normalVal = OGRE_Load3D( voxelNormalTex, gl_GlobalInvocationID.xyz, 0 );
	float4 emissiveVal = OGRE_Load3D( voxelEmissiveTex, gl_GlobalInvocationID.xyz, 0 );

	normalVal.xyz = normalVal.xyz * 2.0f - 1.0f;
	normalVal.xyz = normalize( normalVal.xyz );

	// THE VOXEL EMITS ITS SURFACES' MEAN RADIANCE TIMES THE VOXEL'S OPACITY
	// (PHOTON-VOXEL-3): the emissive and the albedo are area MEANS and the albedo's
	// alpha is the conservative coverage c = max( O_x, O_y, O_z )
	// (VoxelMerge_piece_cs.any), so the light volume is premultiplied by c like the
	// direct term below (whose `alpha` starts at c) - a wall that fills a tenth of
	// the voxel emits a tenth of its radiance into it, and the reader's mip-0 read
	// turns c into the opacity along the ray.
	float3 blockColour = emissiveVal.xyz * albedoVal.w;
	// THE VOXEL'S ROUGHNESS (PHOTON-WRITER-1): the merged perceptual roughness of
	// the surfaces in this voxel, in the emissive volume's alpha
	// (VoxelMerge_piece_cs.any, voxelMergeEmissive).
	float voxelRoughness = emissiveVal.w;

	if( anyInvocationARB( albedoVal.a > 0 ) )
	{
		for( uint lightIdx=0u; lightIdx<p_numLights; ++lightIdx )
		{
			Light light = lights[lightIdx];

			float3 lightDir = light.pos.xyz - voxelAabbCenter * light.pos.w;
			lightDir = normalize( lightDir );

			float NdotL;

			@property( hlms_lights_area_ltc )
				if( light.lightType == LT_AREA_LTC )
				{
					bool doubleSidedLtc = light.points[0].w != 0.0f;
					NdotL = LTC_Evaluate( normalVal.xyz, float3( 0, 1, 0 ), voxelAabbCenter.xyz,
										  buildFloat3x3( float3( 1, 0, 0 ),
														 float3( 0, 1, 0 ),
														 float3( 0, 0, 1 ) ),
										  lights[lightIdx].points, doubleSidedLtc );
					float3 lightStraightDir = float3( light.points[1].w,
													  light.points[2].w,
													  light.points[3].w );
					lightDir += lightStraightDir;
					lightDir = normalize( lightDir );
				}
				else
				{
			@end
					NdotL = dot( normalVal.xyz, lightDir );
					if( normalVal.a > 0 )
						NdotL = abs( NdotL );
					else
						NdotL = saturate( NdotL );

					if( light.lightType == LT_SPOTLIGHT )
					{
						float spotCosAngle = dot( -lightDir, light.spotDirection.xyz );
						float spotAtten = saturate( (spotCosAngle - light.spotParams.y) *
													light.spotParams.x );
						spotAtten = pow( spotAtten, light.spotParams.z );
						NdotL *= spotAtten;
					}
			@property( hlms_lights_area_ltc )
				}
			@end

			// THE ALBEDO THE SURFACE REALLY HAS FOR THIS LAMP (PHOTON-WRITER-1): the
			// normalised Disney diffuse reflects jahDiffuseAlbedo( cos theta_l, r )
			// of the Lambertian answer, summed over every outgoing direction - what
			// an isotropic voxel must hold for its surface. The cosine is the lamp's
			// direction against the voxel's normal (for an LTC area light, its
			// straight direction), abs for a double-sided voxel like NdotL's own.
			float cosAlbedo = dot( normalVal.xyz, lightDir );
			cosAlbedo = normalVal.a > 0 ? abs( cosAlbedo ) : saturate( cosAlbedo );
			float lobeAlbedo = jahDiffuseAlbedo( cosAlbedo, voxelRoughness );

			//lightDir is in world space, it needs to be in UV space (which may be stretched)
			lightDir *= p_dirCorrectionRatio.xyz;
			//Ensure lightDir makes pixel-sized steps
			lightDir /= max3( abs( lightDir.x ), abs( lightDir.y ), abs( lightDir.z ) );

			// THE SHADOW MARCH READS THE OPACITY ALONG THE LAMP (PHOTON-VOXEL-3): per step,
			// the per-axis coverage times the cells the step crosses along each axis -
			// a thin wall in the lamp's way stops it within its own cell, a wall the lamp
			// runs PARALLEL to does not shadow its neighbours - accumulated additively
			// (the pieces of one surface split between voxels add up to the surface,
			// they do not multiply as if they were independent occluders), the same rule
			// as the reader (jah_voxel_sample.glsl, jahVoxelReadPlane). At a
			// coarser mip (an area lamp's widening) the coverage is the mip's MEAN PER CELL
			// over its block, so the cells crossed count exactly as at mip 0 - the reader's
			// own rule (PHOTON-VOXEL-4, INJECT-SHADOW-1: a factor 2^-lod here under-counted
			// an LTC area lamp's widening march by that factor).
			// The pin read the ALBEDO's alpha, one opacity for every direction.
			// THE ORIGIN PLANE: the voxel's own surface - the faces looking TOWARDS the lamp
			// along the axis its normal is dominant on, at their stored depth; the march never
			// counts what lies at or behind it (the lit face itself, a thin wall's back face in
			// the same cell).
			int originAxis = -1;
			float originCoord = 0.0f;
			float originSign = 1.0f;
			{
				float3 an = abs( normalVal.xyz );
				int n = an.x >= an.y ? ( an.x >= an.z ? 0 : 2 ) : ( an.y >= an.z ? 1 : 2 );
				if( lightDir[n] != 0.0f )
				{
					bool towardsP = lightDir[n] > 0.0f;
					float ownO = towardsP
						? OGRE_SampleLevel( voxelCoveragePTex, voxelAlbedoSampler, voxelUvwPos, 0.0f )[n]
						: OGRE_SampleLevel( voxelCoverageNTex, voxelAlbedoSampler, voxelUvwPos, 0.0f )[n];
					if( ownO > 0.0f )
					{
						originAxis = n;
						originCoord = ( towardsP
							? OGRE_SampleLevel( voxelPositionPTex, voxelAlbedoSampler, voxelUvwPos, 0.0f )[n]
							: OGRE_SampleLevel( voxelPositionNTex, voxelAlbedoSampler, voxelUvwPos, 0.0f )[n] ) / ownO;
						originSign = towardsP ? 1.0f : -1.0f;
					}
				}
			}
			float alpha = albedoVal.w;
			const float alphaStart = alpha;
			float occluded = 0.0f;
			bool reachedDst = false;
			float3 currUvwPos = voxelUvwPos + lightDir * p_rayMarchStepSize;
			float lodLevel = 0;

			while( alpha > 0 && !reachedDst )
			{
				// A SHADOW RAY IS STOPPED BY ANY FACE IT CROSSES, from either side (the reader's ray
				// rule, jah_voxel_sample.glsl): a voxel's surface may lie inside another solid (the
				// end of a wall slab hidden in the next wall), and that solid's back face must
				// shadow it - read through the faces looking back only, such a hidden face was lit
				// through the wall (gi.leak_room: 0.03-0.05 of red inside at 0.5 m, 1.0 at 0.05 m
				// on the chain). Both halves together, capped per texel like one surface, read a
				// wall once from outside.
				float3 covP = OGRE_SampleLevel( voxelCoveragePTex, voxelAlbedoSampler, currUvwPos.xyz, lodLevel ).xyz;
				float3 covN = OGRE_SampleLevel( voxelCoverageNTex, voxelAlbedoSampler, currUvwPos.xyz, lodLevel ).xyz;
				float3 coverageAtIt = min( covP + covN, float3( 1.0f, 1.0f, 1.0f ) );
				// THE CROSSING RULE, the reader's (jah_voxel_sample.glsl, jahVoxelReadPlane): the
				// coverage times the cells the step crosses along each axis - the kernel's hats,
				// sampled at the step, sum to one across the steps that straddle a surface, so a
				// thin wall is read to its full coverage (PHOTON-VOXEL-4: a segment gate at the
				// step read w x O, the fetch's blend weight). At a coarser mip the coverage is the
				// mip's MEAN PER CELL, so the cells crossed count exactly as at mip 0. THE ORIGIN
				// PLANE - the voxel's own surface, by its stored depth - is never an occluder.
				float3 stepCells = abs( lightDir * p_rayMarchStepSize ) / p_invVoxelResolution;
				if( originAxis >= 0 && coverageAtIt[originAxis] > 0.0f )
				{
					// both halves' coverage-weighted position (the read takes both)
					float posAt = OGRE_SampleLevel( voxelPositionPTex, voxelAlbedoSampler, currUvwPos.xyz, lodLevel )[originAxis] +
								  OGRE_SampleLevel( voxelPositionNTex, voxelAlbedoSampler, currUvwPos.xyz, lodLevel )[originAxis];
					float oSum = covP[originAxis] + covN[originAxis];
					float u = ( ( posAt / oSum - originCoord ) *
								originSign - p_invVoxelResolution[originAxis] ) /
							  ( 0.5f * p_invVoxelResolution[originAxis] );
					float t = clamp( u, -1.0f, 1.0f );
					coverageAtIt[originAxis] *= t < 0.0f ? 0.5f * ( t + 1.0f ) * ( t + 1.0f )
														  : 1.0f - 0.5f * ( 1.0f - t ) * ( 1.0f - t );
				}
				occluded += dot( coverageAtIt, stepCells ) * p_thinWallCounter;
				alpha = alphaStart * max( 0.0f, 1.0f - occluded );

				currUvwPos += lightDir * p_rayMarchStepSize;
				reachedDst = currUvwPos.x <= 0.0f ||
							 currUvwPos.x >= 1.0f ||
							 currUvwPos.y <= 0.0f ||
							 currUvwPos.y >= 1.0f ||
							 currUvwPos.z <= 0.0f ||
							 currUvwPos.z >= 1.0f;

				//For non-directional lights, check if we've reached the light emitter
				if( light.lightType != LT_DIRECTIONAL )
				{
					float3 toLight = light.uvwPos.xyz - currUvwPos; //NOT unit-length
					float dotDirs = dot( lightDir, toLight );
					if( dotDirs <= 0 )
						reachedDst = true;

					@property( correct_area_light_shadows )
						if( light.lightType == LT_AREA_LTC )
						{
							lightDir *= 1.025f;
							lodLevel += 0.2f;
						}
					@end
				}
			}

			// JAHSHAKA PATCH 0077: THE VOXEL STORES RADIANCE. THE UNIT CHAIN,
			// from the lamp to the pixel, is:
			//
			//   light.diffuse = colour * powerScale = D, and in this tree
			//       D = PI * I  (IrisGL's intensity I; HlmsPbs divides the
			//       diffuse by PI, IrisGL does not -- kD = albedo / PI,
			//       OgreHlmsPbsDatablock.cpp:82-84).
			//   The Lambertian OUTGOING RADIANCE of this voxel's surface is
			//       L_out = rho * E / PI = rho * NdotL * D / PI,
			//       which is exactly what HlmsPbs computes for the direct
			//       lighting of the same surface (NdotL * D * kD).
			//   What stood here was  NdotL * D * rho * shadow  = PI * L_out.
			//
			// The cone gather downstream is a weighted mean of these voxels over
			// a cosine-ish set of directions -- an estimate of E / PI -- and
			// HlmsPbs consumes it as `envColourD` with NO division of its own
			// (200.BRDFs_piece_ps.any: Rd = envColourD * albedo). So a voxel
			// holding PI * L_out made every cone-lit diffuse surface PI times
			// brighter than the EMISSIVE and the AMBIENT sharing the same slot
			// (both of which are radiance already, here and in
			// VctLighting::fillConstBufferData's invFinalMultiplier), and the
			// specular path carried an eye-tuned 0.31831 -- "I'm not sure why is
			// it even needed" -- to cancel this very factor. Patch 0077 removes
			// that fudge with this one line.
			//
			// AND IT IS WHAT THE 8-BIT VOLUME CAN HOLD. The store below is
			// scaled by p_bakingMultiplier = PI / D_max
			// (OgreVctLighting.cpp: autoMultiplierValue), so with the PI the
			// stored value was PI * rho * NdotL * D / D_max -- above 1, i.e.
			// CLIPPED, for every surface with rho * NdotL * D / D_max > 1/PI,
			// which is most lit surfaces. Clipping an RGB triple channel by
			// channel does not just darken it, it desaturates it: a red wall at
			// (1.0, 0.31, 0.31) bleeds pink. With the PI gone the stored value
			// is rho * NdotL * D / D_max, at most exactly 1 -- the whole 8-bit
			// range, used and never exceeded, and the bleed keeps its hue.
			// JAHSHAKA (CLOUDS-2D-2): A DIRECTIONAL LIGHT CROSSES THE CLOUD SHEET on
			// its way to this voxel -- the same transmittance the pixel's direct
			// term takes (the piece JahCloudShadow), at the voxel's world centre,
			// so a voxel and the surface it stands for are darkened by one factor.
			@property( jah_cloud_shadow )
				if( light.pos.w == 0.0f )
					alpha *= jahCloudTransmittance( voxelAabbCenter + jahCloudOrigin.xyz,
													jahCloudMap, jahCloudSun );
			@end
			blockColour += c_invPI * NdotL * lobeAlbedo * light.diffuse.xyz * alpha * albedoVal.xyz;
		}
	}

	blockColour *= p_bakingMultiplier;

	wshort3 voxelCelUvw = wshort3( gl_GlobalInvocationID.xyz );
	float4 injectedVoxel = float4( blockColour, albedoVal.w );
	OGRE_imageWrite3D4( lightVoxel, voxelCelUvw, jahStoreLight( injectedVoxel ) );
	// JAHSHAKA PATCH 0076: the same value, kept apart as the bounce iteration's
	// D term. One extra image store; no copy and no second dispatch.
	// JAHSHAKA PATCH 0080: encoded for ITS OWN format, which is not the total's
	// any more -- the total may be float and this one is always 8-bit sRGB.
	@property( vct_keep_direct )
		OGRE_imageWrite3D4( directVoxel, voxelCelUvw, jahStoreDirect( injectedVoxel ) );
	@end
@end
