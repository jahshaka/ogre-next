
//#include "SyntaxHighlightingMisc.h"

@piece( HeaderCS )
	CONST_BUFFER_STRUCT_BEGIN( IrradianceFieldGenParams, 0 )
	{
		float invNumRaysPerPixel;
		float invNumRaysPerIrradiancePixel;
		float unused0;
		uint probesPerRow; // Used by integration CS, not by us

		float coneAngleTan;
		uint numProcessedProbes;
		float unused1;
		float unused2;

		//float invFieldResolution;
		uint4 numProbes_threadsPerRow;

		float4x4 irrProbeToVctTransform;

		// Jahshaka (PHOTON-READER-1): the cascade chain, as VctLighting's one
		// definition writes it (getCascadeChainParams) - sized by
		// IrradianceField::kMaxChainCascades = 8.
		float4 vctInvResMaxLod[8];
		float4 vctFromPrev[14];

		// Jahshaka (PHOTON-ENV-1): THE ONE ENVIRONMENT an escaping probe ray sees,
		// in cascade 0's STORED units (IrradianceField::update divides by its
		// decode multiplier): rgb = the environment light's gain on the cube,
		// w = the cube's mip count; and its nine-band SH, world axes.
		float4 envGainMips;
		float4 envSh[9];
	}
	CONST_BUFFER_STRUCT_END( p );

	#define numProbes numProbes_threadsPerRow.xyz
	#define threadsPerRow numProbes_threadsPerRow.w

	struct Probe
	{
		float3 center;
	};

	// THE PROBE RAY IS A CONE OF THE ONE VOXEL RADIANCE READER (Jahshaka,
	// PHOTON-READER-1; render audit F7). This job used to carry a THIRD march:
	// cascade 0 only (`while( dist < 1.414 && alpha < 0.95 )` in cascade 0's unit
	// box, the outer cascades never read), no cone age (the footprint restarted
	// from the bias), and the escape it computed thrown away - so inside a hall the
	// field integrated cascade 0's bounce alone while the pixel's cones walked the
	// chain, and the pixel blended two integrals of two radiance fields. Each ray
	// is now `jahConeMarch` over the WHOLE chain with the pixel's rules
	// (jah_voxel_sample.glsl + jah_voxel_march.glsl, wrapped by Jahshaka's build
	// into the pieces JahVoxelSample / JahVoxelMarch, named in this job's piece
	// list). A probe is a point in free space: no surface bias at the start or at a
	// hop, and the hop's step back is measured along the ray.
	#define JAH_VOX_MAX_CASCADES @value( hlms_num_vct_cascades )
	#define JAH_VOX_COUNT @value( hlms_num_vct_cascades )
	#define JAH_VOX_SAMPLE_ISO( c, u, l ) OGRE_SampleLevel( vctProbes[c], probeSampler, u, l )
	@property( vct_anisotropic )
		#define JAH_VOX_HAS_ANISO 1
		#define JAH_VOX_ANISO true
		#define JAH_VOX_SAMPLE_X( c, u, l ) OGRE_SampleLevel( vctProbeX[c], probeSampler, u, l )
		#define JAH_VOX_SAMPLE_Y( c, u, l ) OGRE_SampleLevel( vctProbeY[c], probeSampler, u, l )
		#define JAH_VOX_SAMPLE_Z( c, u, l ) OGRE_SampleLevel( vctProbeZ[c], probeSampler, u, l )
	@else
		#define JAH_VOX_HAS_ANISO 0
		#define JAH_VOX_ANISO false
	@end
	#define JAH_VOX_INVRES( c ) p.vctInvResMaxLod[c].xyz
	#define JAH_VOX_MAXLOD( c ) p.vctInvResMaxLod[c].w
	#define JAH_VOX_FROM_PREV_SCALE( c ) p.vctFromPrev[( (c) - 1 ) * 2]
	#define JAH_VOX_FROM_PREV_OFFSET( c ) p.vctFromPrev[( (c) - 1 ) * 2 + 1]
	@insertpiece( JahVoxelSample )
	@insertpiece( JahVoxelMarch )

	// THE ONE ENVIRONMENT (Jahshaka, PHOTON-ENV-1; jah_environment.glsl, wrapped
	// into the piece JahEnvironment): the cube at the unit after every volume
	// (IrradianceField::bindChainToGenerationJob, job property jah_env), sampled
	// with the volumes' sampler.
	@property( jah_env )
		#define JAH_ENV_CUBE_ON true
		#define JAH_ENV_SAMPLE( d, l ) OGRE_SampleLevel( envCube, probeSampler, d, l ).xyz
	@else
		#define JAH_ENV_CUBE_ON false
		#define JAH_ENV_SAMPLE( d, l ) float3( 0, 0, 0 )
	@end
	#define JAH_ENV_MIPS p.envGainMips.w
	#define JAH_ENV_GAIN p.envGainMips.xyz
	#define JAH_ENV_SH_C0 p.envSh[0].xyz
	#define JAH_ENV_SH_C1 p.envSh[1].xyz
	#define JAH_ENV_SH_C2 p.envSh[2].xyz
	#define JAH_ENV_SH_C3 p.envSh[3].xyz
	#define JAH_ENV_SH_C4 p.envSh[4].xyz
	#define JAH_ENV_SH_C5 p.envSh[5].xyz
	#define JAH_ENV_SH_C6 p.envSh[6].xyz
	#define JAH_ENV_SH_C7 p.envSh[7].xyz
	#define JAH_ENV_SH_C8 p.envSh[8].xyz
	@insertpiece( JahEnvironment )

	#define RayIndex uint
	#define ProbeIndex uint

	INLINE RayIndex getRayIndex( uint2 globalInvocationId PARAMS_ARG_DECL )
	{
		return globalInvocationId.x + globalInvocationId.y * p.threadsPerRow;
	}

	INLINE ProbeIndex getProbeIdx( RayIndex rayIndex PARAMS_ARG_DECL )
	{
		return rayIndex / @value( num_rays_per_probe )u + p.numProcessedProbes;
	}

	INLINE ushort4 getIrradianceFieldIrradDepthXY( RayIndex rayIndex, ProbeIndex probeIdx )
	{
		ushort2 irradXY;
		uint irradPixelIdx = rayIndex / @value( num_rays_per_irrad_pixel )u;
		// Calculate local xy pixel e.g. irradXY is in range [0; 8)
		irradXY.x = irradPixelIdx % @value( irrad_resolution )u;
		irradXY.y = (irradPixelIdx % @value( num_irrad_pixels_per_probe )u) / @value( irrad_resolution )u;

		ushort2 depthXY = irradXY; // Store depthXY for later

		// Calculate local -> global xy pixel e.g. irradXY is in range [0; 2560)
		ushort borderedResolution = @value( irrad_resolution )u + 2u;
		irradXY.x += (probeIdx * borderedResolution) % @value( irrad_full_width )u;
		irradXY.y += ((probeIdx * borderedResolution) / @value( irrad_full_width )u) *
					 borderedResolution;

		// Scale depthXY to proper range e.g. depthXY is in range [0; 16)
		depthXY.xy *= @value( colour_to_depth_resolution_ratio );

		// depthXY is in proper range, but instead of being 0, 1, 2, 3, 4, 5, ... 15
		// many of these values are repeated: 0, 0, 0, 0, 4, 4, 4, 4, 8, 8, 8, 8, 12, 12, 12, 12
		// We need to fix that
		uint irradPixelRaySubIdx = rayIndex % @value( num_rays_per_irrad_pixel )u;
		depthXY.x += irradPixelRaySubIdx % @value( colour_to_depth_resolution_ratio )u;
		depthXY.y += irradPixelRaySubIdx / @value( colour_to_depth_resolution_ratio )u;

		// Calculate local -> global xy pixel e.g. depthXY is in range [0; 4608)
		borderedResolution = @value( depth_resolution )u + 2u;
		depthXY.x += (probeIdx * borderedResolution) % @value( depth_full_width )u;
		depthXY.y += ((probeIdx * borderedResolution) / @value( depth_full_width )u) *
					 borderedResolution;

		ushort4 retVal = ushort4 ( irradXY, depthXY );

		// Skip top-left border
		retVal += 1u;

		return retVal;
	}

	INLINE float3 getProbeCenterInVctSpace( ProbeIndex probeIdx PARAMS_ARG_DECL )
	{
		// Snippet taken from Dynamic Diffuse Global Illumination with Ray-Traced Irradiance Fields
		// Zander Majercik, NVIDIA; Jean-Philippe Guertin, Université de Montréal;
		// Derek Nowrouzezahrai, McGill University; Morgan McGuire, NVIDIA and McGill University
		// http://jcgt.org/published/0008/02/01/

		// Works for any # of probes
		/*
		iPos.x = probeIdx % p.numProbes.x;
		iPos.y = (probeIdx % (p.numProbes.x * p.numProbes.y)) / p.numProbes.x;
		iPos.z = probeIdx / (p.numProbes.x * p.numProbes.y);
		*/

		// Assumes numProbes are powers of two.
		// Saves ~10ms compared to the divisions above
		// Precomputing the MSB actually slows this code down substantially
		float3 vPos;
		vPos.x = probeIdx & (p.numProbes.x - 1u);
		vPos.y = (probeIdx & ((p.numProbes.x * p.numProbes.y) - 1u)) >> findMSB( p.numProbes.x );
		vPos.z = probeIdx >> findMSB( p.numProbes.x * p.numProbes.y );
		return vPos;
	}
@end

//in uvec3 gl_NumWorkGroups;
//in uvec3 gl_WorkGroupID;
//in uvec3 gl_LocalInvocationID;
//in uvec3 gl_GlobalInvocationID;
//in uint  gl_LocalInvocationIndex;

@piece( BodyCS )
	RayIndex rayIdx = getRayIndex( gl_GlobalInvocationID.xy PARAMS_ARG );
	ProbeIndex probeIdx = getProbeIdx( rayIdx PARAMS_ARG );

	float3 dir = bufferFetch( directionsBuffer, rshort( rayIdx % @value( num_rays_per_probe ) ) ).xyz;

	float3 probeCenter = getProbeCenterInVctSpace( probeIdx PARAMS_ARG );
	float3 posLS = mul( float4( probeCenter, 1.0f ), p.irrProbeToVctTransform ).xyz;

	// THE START BIAS (0070's rule, the ray's own direction as the bias direction).
	// A probe sits at a lattice point, and one standing in or beside a surface's
	// own cell would otherwise meet that cell's opacity on its first sample. The
	// ray leaves by one cell of cascade 0 along itself, componentwise, and the
	// march then takes its own first step (one cell measured along the ray, the L1
	// cell) before it samples: THE FIRST SAMPLE IS TWO CELLS FROM THE PROBE along an
	// axis and up to 2.73 along a diagonal - the pixel cone's geometry (surface,
	// one cell along the normal, the march's step). Measured at 0 / 1 / 2 extra
	// cells (PHOTON-READER-1): gi.ddgi_ambient's floor 0.914 / 0.915 / 0.915 of its
	// truth, the sealed room 1 / 1 / 3 codes, gi.leak_room's thin walls within
	// 0.004 of each other at 0 and 1 - nothing overrules the pixel's geometry.
	float3 startBias = dir * JAH_VOX_INVRES( 0 );
	// JAH_MARCH_NO_ESCAPE: this job reads the ray's own composite, never the
	// march's occupancy estimate (why: the escape, below).
	JahConeResult ray = jahConeMarch( posLS + startBias, dir, p.coneAngleTan, float3( 0, 0, 0 ),
									  float3( 0, 0, 0 ),
									  JAH_MARCH_GAP_ALONG_DIR | JAH_MARCH_NO_ESCAPE );
	// THE DEPTH STAYS CASCADE-0-LOCAL AND IS MEASURED FROM THE PROBE: the march's
	// age converted back into cascade 0's normalised units (travelledC0 = the age
	// in the last cascade's units over the product of the per-hop scales along the
	// ray), plus the start bias's own length - and BOUNDED at cascade 0's diagonal,
	// 1.414, the old march's own exit. A miss has no distance; the moments feed
	// the Chebyshev visibility test, and an unbounded miss distance (the chain's
	// exit is ~8x further) blows up the variance of every texel that mixes hits
	// and misses - a probe beside a wall, rays over its top - which is where the
	// test has to bite (DDGI bounds a miss the same way).
	// THE SKY IS PART OF THE PROBE'S IRRADIANCE (Jahshaka, PHOTON-ENV-1). The share
	// of this ray the voxels did not stop — `1 - min( 1, opacity / 0.95 )`, the
	// same escape the pixel's cones weight theirs by — sees the ONE ENVIRONMENT in
	// the ray's direction at the ray's own aperture (the solid angle 2 pi / N of a
	// probe's N rays), and the cosine integration below carries it into the
	// irradiance atlas beside the bounce: one integral of everything the probe
	// sees. THE OPACITY IS THE RAY'S OWN COMPOSITE (`alpha`), NOT THE MARCH'S
	// OCCUPANCY ESTIMATE, and that is physics: the occupancy estimate exists for a
	// cone that STARTS ON A SURFACE (in the anisotropic volumes the directional
	// composite of its own slab's cell reads opaque at every coarser mip). A probe
	// ray starts in free space and CROSSES what it meets, and for a ray crossing a
	// wall the directional composite IS the transmittance — measured on
	// gi.ddgi_ambient's sealed room (PHOTON-READER-1): the occupancy estimate let
	// 11/255 of sky through the walls, the composite 1/255. The probe's directions
	// are world directions (the march reads them as cascade 0's, upstream's own
	// approximation for a box that is not a cube); the environment reads them as
	// what they are.
	const float escape = 1.0 - min( 1.0, ray.alpha / 0.95 );
	const float3 sky = escape * jahEnvCone( normalize( dir ), p.coneAngleTan );
	float4 diffuse = float4( ray.colour + sky,
							 min( ray.travelledC0 + length( startBias ), 1.414213562 ) *
								 dot( abs( dir ), float3( p.numProbes.xyz ) ) );
	g_diffuseDepth[gl_LocalInvocationIndex] = diffuse;

	__sharedOnlyBarrier;

	ushort4 irradDepthXY = getIrradianceFieldIrradDepthXY( rayIdx, probeIdx );

	if( gl_LocalInvocationIndex % @value( num_rays_per_depth_pixel )u == 0u )
	{
		float sqDepth = diffuse.w * diffuse.w;

		//Reduction
		for( uint i=1u; i<@value( num_rays_per_depth_pixel )u; ++i )
		{
			float4 otherVal = g_diffuseDepth[gl_LocalInvocationIndex + i];
			diffuse.xyzw += otherVal.xyzw;
			sqDepth += otherVal.w * otherVal.w;
		}

		//We can already write depth
		diffuse.w *= p.invNumRaysPerPixel;
		sqDepth *= p.invNumRaysPerPixel;
		OGRE_imageWrite2D4( irradianceFieldDepth, irradDepthXY.zw,
							float4( diffuse.w, sqDepth, 0.0, 0.0 ) );

		g_diffuseDepth[gl_LocalInvocationIndex].xyz = diffuse.xyz;
	}

	__sharedOnlyBarrier;

	// Irradiance has 'bigger pixels' than depth, thus we need to reduce again.
	if( gl_LocalInvocationIndex % @value( num_rays_per_irrad_pixel ) == 0u )
	{
		for( uint i=1u; i<@value( reduction_iterations ); ++i )
			diffuse.xyz += g_diffuseDepth[gl_LocalInvocationIndex + i * @value( num_rays_per_depth_pixel )u].xyz;

		diffuse.xyz *= p.invNumRaysPerIrradiancePixel;

		OGRE_imageWrite2D4( irradianceField, irradDepthXY.xy, diffuse );
	}
@end
